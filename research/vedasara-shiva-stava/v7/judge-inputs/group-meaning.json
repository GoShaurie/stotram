    "compounds": {
      "c1": {
        "members": [
          "w10"
        ],
        "iast": "tamaḥ-pāram",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "तमसः पारम्",
        "meaning": {
          "en": "the far shore of the darkness of ignorance",
          "hi": "अज्ञान-रूपी अन्धकार का पार"
        },
        "note": {
          "en": "tamas 'darkness' + pāra 'the far bank'. The -m before ādyanta shows that this part is a full word of its own, written joined to the next.",
          "hi": "तमस् 'अन्धकार' + पार 'उस पार का किनारा'। आद्यन्त से पहले का -म् दिखाता है कि यह भाग अपने आप में पूरा शब्द है, जो अगले शब्द से जुड़ा लिखा गया है।"
        }
      },
      "c2": {
        "members": [
          "w10"
        ],
        "iast": "ādy-anta-hīnam",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "structure": "((ādi-anta)-hīna)",
        "vigraha": "आदिश्च अन्तश्च आद्यन्तौ, ताभ्यां हीनः, तम्",
        "meaning": {
          "en": "without beginning and end",
          "hi": "आदि और अन्त से रहित"
        },
        "note": {
          "en": "ādi 'beginning' and anta 'end' are first paired (ādyanta), then joined to hīna 'without'.",
          "hi": "आदि 'आरम्भ' और अन्त 'समाप्ति' पहले जोड़ी बनाते हैं (आद्यन्त), फिर हीन 'रहित' से जुड़ते हैं।"
        }
      },
      "c3": {
        "members": [
          "w14"
        ],
        "iast": "dvaita-hīnam",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "vigraha": "द्वैतेन हीनः, तम्",
        "meaning": {
          "en": "free of duality",
          "hi": "द्वैत से रहित"
        },
        "note": {
          "en": "dvaita 'twoness, duality' + hīna 'without'.",
          "hi": "द्वैत 'दो-पन' + हीन 'रहित'।"
        }
      }
    },
