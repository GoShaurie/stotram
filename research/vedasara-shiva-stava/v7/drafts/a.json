              "w4"
            ],
            "text": "of causes;"
          }
        ],
        [
          {
            "refs": [
              "w5"
            ],
            "text": "Śiva,"
          },
          {
            "refs": [
              "w6"
            ],
            "text": "the One alone,"
          },
          {
            "refs": [
              "w7"
            ],
            "text": "the light-giver"
          },
          {
            "refs": [
              "w8"
            ],
            "text": "of light-givers;"
          }
        ],
        [
          {
            "refs": [
              "w9"
            ],
            "text": "the Fourth,"
          },
          {
            "refs": [
              "w10"
            ],
            "text": "the far shore of darkness, with no beginning and no end:"
          }
        ],
        [
          {
            "refs": [
              "w5"
            ],
            "text": "in Him,"
          },
          {
            "refs": [
              "w12"
            ],
            "text": "the Supreme,"
          },
          {
            "refs": [
              "w13"
            ],
            "text": "who makes pure,"
          },
          {
            "refs": [
              "w14"
            ],
            "text": "free of duality,"
          },
          {
            "refs": [
              "w11"
            ],
            "text": "I take refuge."
          }
        ]
      ],
      "bhavartha": "Śiva was never born and never ends. He is the cause behind the causes, and the light-giver to everything that gives light. He is alone and pure, the Fourth, on the far side of darkness, with no beginning and no end. In this supreme One, who makes pure and in whom there is no 'two', the poet takes refuge."
    },
