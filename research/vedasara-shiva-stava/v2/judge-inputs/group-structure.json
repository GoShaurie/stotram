    "compounds": {
      "c1": {
        "members": [
          "w1"
        ],
        "iast": "mahā-īśaṃ",
        "type": "karmadhāraya",
        "vigraha": "महान् ईशः",
        "meaning": {
          "en": "the great Lord",
          "hi": "महान ईश्वर"
        },
        "note": {
          "en": "mahat 'great' takes the form mahā at the start of a compound and describes īśa 'lord'; ā + ī merge into e: mahā + īśa → maheśa.",
          "hi": "समास के आरम्भ में महत् 'महान' का रूप महा हो जाता है और यह ईश 'स्वामी' का विशेषण है; आ + ई मिलकर ए बनते हैं: महा + ईश → महेश।"
        }
      },
      "c2": {
        "members": [
          "w2"
        ],
        "iast": "sura-īśaṃ",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "सुराणाम् ईशः",
        "meaning": {
          "en": "the Lord of the gods",
          "hi": "देवताओं के स्वामी"
        },
        "note": {
          "en": "sura 'god' + īśa 'lord'; a + ī merge into e: sura + īśa → sureśa.",
          "hi": "सुर 'देवता' + ईश 'स्वामी'; अ + ई मिलकर ए बनते हैं: सुर + ईश → सुरेश।"
        }
      },
      "c3": {
        "members": [
          "w3"
        ],
        "iast": "sura-arāti-nāśaṃ",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((sura-arāti)-nāśa)",
        "vigraha": "सुराणाम् अरातयः सुरारातयः, तेषां नाशः",
        "meaning": {
          "en": "the destroyer of the gods' enemies",
          "hi": "देवताओं के शत्रुओं का नाश करने वाले"
        },
        "note": {
          "en": "sura-arāti 'the gods' enemies' (a + a merge into ā) is closed by nāśa 'destruction', which at the end of a compound means 'destroying': the one who destroys the gods' enemies.",
          "hi": "सुर-अराति 'देवताओं के शत्रु' (अ + अ मिलकर आ) के बाद नाश 'विनाश' आता है, जो समास के अन्त में 'नाश करने वाला' का अर्थ देता है: देवताओं के शत्रुओं का नाश करने वाले।"
        }
      },
      "c4": {
        "members": [
          "w5"
        ],
        "iast": "viśva-nāthaṃ",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "विश्वस्य नाथः",
        "meaning": {
          "en": "the Lord of the universe",
          "hi": "विश्व के नाथ"
        },
        "note": {
          "en": "viśva 'the universe, all' + nātha 'lord, protector'.",
          "hi": "विश्व 'संसार, सब' + नाथ 'स्वामी, रक्षक'।"
        }
      },
      "c5": {
        "members": [
          "w6"
        ],
        "iast": "vibhūty-aṅga-bhūṣam",
        "type": "bahuvrīhi",
        "structure": "(vibhūti-(aṅga-bhūṣā))",
        "vigraha": "विभूतिः अङ्गभूषा यस्य सः, तम्",
        "meaning": {
          "en": "Him whose body's ornament is sacred ash",
          "hi": "उन (शिव) को, जिनके अंगों का आभूषण भस्म है"
        },
        "note": {
          "en": "aṅga-bhūṣā 'ornament of the body'; with vibhūti 'sacred ash' the whole describes Śiva, the one whose body-ornament is ash. bhūṣā shortens to bhūṣa at the end, as the compound describes a man. i + a become ya: vibhūti + aṅga → vibhūtyaṅga.",
          "hi": "अङ्ग-भूषा 'शरीर का आभूषण'; विभूति 'भस्म' के साथ पूरा समास शिव का वर्णन करता है, जिनके शरीर का आभूषण भस्म है। पुरुष का वर्णन होने से अन्त का भूषा छोटा होकर भूष बनता है। इ + अ मिलकर य बनते हैं: विभूति + अङ्ग → विभूत्यङ्ग।"
        }
      },
      "c6": {
        "members": [
          "w7"
        ],
        "iast": "virūpa-akṣam",
        "type": "bahuvrīhi",
        "vigraha": "विरूपाणि अक्षीणि यस्य सः, तम्",
        "meaning": {
          "en": "Him whose eyes are unlike any other's",
          "hi": "उन (शिव) को, जिनके नेत्र अनोखे हैं"
        },
        "note": {
          "en": "virūpa 'odd, uncommon' + akṣa 'eye' (the form akṣi takes at the end of such a compound); a + a merge into ā. Only the first part of the display word is this compound.",
          "hi": "विरूप 'विषम, अनोखा' + अक्ष 'नेत्र' (ऐसे समास के अन्त में अक्षि का यही रूप होता है); अ + अ मिलकर आ बनते हैं। प्रदर्शित शब्द का केवल पहला भाग यह समास है।"
        }
      },
      "c7": {
        "members": [
          "w7"
        ],
        "iast": "indv-arka-vahni-tri-netraṃ",
        "type": "bahuvrīhi",
        "structure": "((indu-arka-vahni)-(tri-netra))",
        "vigraha": "इन्दुः अर्कः वह्निः च त्रीणि नेत्राणि यस्य सः, तम्",
        "meaning": {
          "en": "Him whose three eyes are the moon, the sun and fire",
          "hi": "उन (शिव) को, जिनके तीन नेत्र चन्द्रमा, सूर्य और अग्नि हैं"
        },
        "note": {
          "en": "indu-arka-vahni 'moon, sun and fire' lists three things side by side; tri-netra 'three eyes'. The whole describes Śiva, the one whose three eyes are these three lights. u + a become va: indu + arka → indvarka.",
          "hi": "इन्दु-अर्क-वह्नि 'चन्द्रमा, सूर्य और अग्नि' तीनों को साथ-साथ गिनाता है; त्रि-नेत्र 'तीन नेत्र'। पूरा समास शिव का वर्णन करता है, जिनके तीन नेत्र ये तीन ज्योतियाँ हैं। उ + अ मिलकर व बनते हैं: इन्दु + अर्क → इन्द्वर्क।"
        }
      },
      "c8": {
        "members": [
          "w8"
        ],
        "iast": "sadā-ānandam",
        "type": "bahuvrīhi",
        "vigraha": "सदा आनन्दः यस्य सः, तम्",
        "meaning": {
          "en": "Him who is always in bliss",
          "hi": "उन (शिव) को, जो सदा आनन्द में हैं"
        },
        "note": {
          "en": "sadā 'always' + ānanda 'bliss'; ā + ā merge into one ā. Only the first part of the display word is this compound; īḍe 'I praise' is a separate word written with it.",
          "hi": "सदा 'हमेशा' + आनन्द 'परम सुख'; आ + आ मिलकर एक आ बनता है। प्रदर्शित शब्द का केवल पहला भाग यह समास है; ईडे 'मैं स्तुति करता हूँ' अलग शब्द है जो साथ लिखा है।"
        }
      },
      "c9": {
        "members": [
          "w10"
        ],
        "iast": "pañca-vaktram",
        "type": "bahuvrīhi",
        "vigraha": "पञ्च वक्त्राणि यस्य सः, तम्",
        "meaning": {
          "en": "Him who has five faces",
          "hi": "उन (शिव) को, जिनके पाँच मुख हैं"
        },
        "note": {
          "en": "pañca 'five' + vaktra 'face': the one who has five faces, a name of Śiva.",
          "hi": "पञ्च 'पाँच' + वक्त्र 'मुख': जिनके पाँच मुख हैं, शिव का एक नाम।"
        }
      }
    },
