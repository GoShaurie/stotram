        ],
        "sandhi": [
          {
            "name": "savarṇa-dīrgha",
            "rule": "i + ī → ī",
            "explanation": {
              "en": "The i of giri and the ī of īśa merge into one long ī: giri + īśa → girīśa.",
              "hi": "गिरि का 'इ' और ईश का 'ई' मिलकर एक दीर्घ 'ई' बनते हैं: गिरि + ईश → गिरीश।"
            }
          },
          {
            "name": "anusvāra",
            "rule": "m + consonant → ṃ",
            "explanation": {
              "en": "Final m is written as ṃ before the consonant of the next word (gaṇeśaṃ): girīśam → girīśaṃ.",
              "hi": "अगले शब्द (गणेशं) के व्यंजन से पहले अन्तिम 'म्' अनुस्वार बन जाता है: गिरीशम् → गिरीशं।"
            }
          }
        ],
