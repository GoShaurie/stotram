    "title": {
      "sa": "वेदसारशिवस्तवः",
      "iast": "Vedasāraśivastavaḥ",
      "en": "Vedasara Shiva Stava",
      "hi": "वेदसार शिव स्तव"
    },
    "deities": [
      "shiva"
    ],
    "tradition": {
      "id": "shaiva"
    }
  },
  "verse": {
    "id": "v3",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "गिरीशं",
            "iast": "girīśaṃ"
          },
          {
            "id": "w2",
            "text": "गणेशं",
            "iast": "gaṇeśaṃ"
          },
          {
            "id": "w3",
            "text": "गले",
            "iast": "gale"
          },
          {
            "id": "w4",
            "text": "नीलवर्णं",
            "iast": "nīlavarṇaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w5",
            "text": "गवेन्द्राधिरूढं",
            "iast": "gavendrādhirūḍhaṃ"
          },
          {
            "id": "w6",
            "text": "गुणातीतरूपम्",
            "iast": "guṇātītarūpam"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w7",
            "text": "भवं",
            "iast": "bhavaṃ"
          },
          {
            "id": "w8",
            "text": "भास्वरं",
            "iast": "bhāsvaraṃ"
          },
          {
            "id": "w9",
            "text": "भस्मना",
            "iast": "bhasmanā"
          },
          {
            "id": "w10",
            "text": "भूषिताङ्गं",
            "iast": "bhūṣitāṅgaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w11",
            "text": "भवानीकलत्रं",
            "iast": "bhavānīkalatraṃ"
          },
          {
            "id": "w12",
            "text": "भजे",
            "iast": "bhaje"
          },
          {
            "id": "w13",
            "text": "पञ्चवक्त्रम्",
            "iast": "pañcavaktram"
          }
        ],
        "end": "॥ ३ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w1"
        ],
        "iast": "gir-īśaṃ",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "गिरेः ईशः, तम्",
        "meaning": {
          "en": "the Lord of the mountain",
          "hi": "पर्वत के स्वामी"
        },
        "note": {
          "en": "giri 'mountain' + īśa 'lord': the lord of the mountain. The two i-sounds merge into one long ī.",
          "hi": "गिरि 'पर्वत' + ईश 'स्वामी': पर्वत के स्वामी। दोनों इ-ध्वनियाँ मिलकर एक दीर्घ ई बन जाती हैं।"
        }
      },
      "c2": {
        "members": [
          "w2"
        ],
        "iast": "gaṇ-eśaṃ",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "गणानाम् ईशः, तम्",
        "meaning": {
          "en": "the Lord of the gaṇas, His hosts of attendants",
          "hi": "गणों के, अर्थात् सेवक-दलों के स्वामी"
        },
        "note": {
          "en": "gaṇa 'host, troop of attendants' + īśa 'lord'; a + ī becomes e.",
          "hi": "गण 'सेवकों का दल' + ईश 'स्वामी'; अ + ई मिलकर ए बनता है।"
        }
      },
      "c3": {
        "members": [
          "w4"
        ],
        "iast": "nīla-varṇaṃ",
        "type": "bahuvrīhi",
        "vigraha": "(गले) नीलः वर्णः यस्य सः, तम्",
        "meaning": {
          "en": "(Him) whose colour is blue (at the throat)",
          "hi": "(उन्हें) जिनका (कण्ठ में) रंग नीला है"
        },
        "note": {
          "en": "nīla 'blue' + varṇa 'colour'; the compound describes the one who has that colour, and gale 'on the throat' says where.",
          "hi": "नील 'नीला' + वर्ण 'रंग'; समास उसका वर्णन करता है जिसका यह रंग है, और 'गले' बताता है कि कहाँ।"
        }
      },
      "c4": {
        "members": [
          "w5"
        ],
        "iast": "gav-endr-ādhirūḍhaṃ",
        "type": "tatpuruṣa",
        "subtype": "dvitīyā",
        "structure": "((gava-indra)-adhirūḍha)",
        "vigraha": "गवाम् इन्द्रः गवेन्द्रः, गवेन्द्रम् अधिरूढः, तम्",
        "meaning": {
          "en": "riding the king of bulls",
          "hi": "बैलों के राजा पर सवार"
        },
        "note": {
          "en": "gavendra 'chief of cattle', i.e. the king of bulls, is itself a compound of go and indra; adhirūḍha 'mounted on' takes it as what is mounted.",
          "hi": "गवेन्द्र 'गौओं में श्रेष्ठ', अर्थात् बैलों का राजा, स्वयं गो और इन्द्र का समास है; अधिरूढ 'चढ़ा हुआ' उसे वह बताता है जिस पर सवारी है।"
        }
      },
      "c5": {
        "members": [
          "w6"
        ],
        "iast": "guṇ-ātīta-rūpam",
        "type": "bahuvrīhi",
        "structure": "((guṇa-atīta)-rūpa)",
        "vigraha": "गुणान् अतीतं रूपं यस्य सः, तम्",
        "meaning": {
          "en": "(Him) whose form is beyond the guṇas",
          "hi": "(उन्हें) जिनका रूप गुणों से परे है"
        },
        "note": {
          "en": "guṇātīta 'gone beyond the guṇas' describes rūpa 'form'; the whole describes Śiva, who has such a form.",
          "hi": "गुणातीत 'गुणों से परे' रूप का विशेषण है; पूरा समास उन शिव का वर्णन करता है जिनका ऐसा रूप है।"
        }
      },
      "c6": {
        "members": [
          "w10"
        ],
        "iast": "bhūṣit-āṅgaṃ",
        "type": "bahuvrīhi",
        "vigraha": "(भस्मना) भूषितम् अङ्गं यस्य सः, तम्",
        "meaning": {
          "en": "(Him) whose body is adorned (with ash)",
          "hi": "(उन्हें) जिनका शरीर (भस्म से) सजा है"
        },
        "note": {
          "en": "bhūṣita 'adorned' + aṅga 'body'; bhasmanā 'with ash' says with what.",
          "hi": "भूषित 'सजा हुआ' + अङ्ग 'शरीर'; 'भस्मना' बताता है किससे।"
        }
      },
      "c7": {
        "members": [
          "w11"
        ],
        "iast": "bhavānī-kalatraṃ",
        "type": "bahuvrīhi",
        "vigraha": "भवानी कलत्रं यस्य सः, तम्",
        "meaning": {
          "en": "(Him) whose wife is Bhavānī",
          "hi": "(उन्हें) जिनकी पत्नी भवानी हैं"
        },
        "note": {
          "en": "kalatra 'wife' is a neuter word, but the compound describes Śiva and so takes His form.",
          "hi": "कलत्र 'पत्नी' नपुंसक शब्द है, पर समास शिव का वर्णन करता है, इसलिए उन्हीं का रूप लेता है।"
        }
      },
      "c8": {
        "members": [
          "w13"
        ],
        "iast": "pañca-vaktram",
        "type": "bahuvrīhi",
        "vigraha": "पञ्च वक्त्राणि यस्य सः, तम्",
        "meaning": {
          "en": "(Him) who has five faces",
          "hi": "(उन्हें) जिनके पाँच मुख हैं"
        },
        "note": {
          "en": "pañca 'five' + vaktra 'face': the one who has five faces, a name of Śiva.",
          "hi": "पञ्च 'पाँच' + वक्त्र 'मुख': जिसके पाँच मुख हैं, शिव का नाम।"
        }
      }
    },
