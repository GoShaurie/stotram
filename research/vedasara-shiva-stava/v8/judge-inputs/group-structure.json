    "compounds": {
      "c1": {
        "members": [
          "w4"
        ],
        "iast": "viśva-mūrte",
        "type": "bahuvrīhi",
        "vigraha": "विश्वं मूर्तिः यस्य सः, तत्सम्बुद्धौ",
        "meaning": {
          "en": "O You whose form is the universe",
          "hi": "हे वे, जिनकी देह सारा विश्व है"
        },
        "note": {
          "en": "viśva 'the whole world' and mūrti 'form, body'; the compound describes the one whose form is the world, Śiva, and is addressed to Him (mūrte).",
          "hi": "विश्व 'सारा संसार' और मूर्ति 'रूप, देह'; समास उनका वर्णन करता है जिनका रूप संसार है, अर्थात् शिव का, और उन्हें ही पुकारता है (मूर्ते)।"
        }
      },
      "c2": {
        "members": [
          "w7"
        ],
        "iast": "cid-ānanda-mūrte",
        "type": "bahuvrīhi",
        "structure": "((cit-ānanda)-mūrti)",
        "vigraha": "चिच्च आनन्दश्च चिदानन्दम्, चिदानन्दं मूर्तिः यस्य सः, तत्सम्बुद्धौ",
        "meaning": {
          "en": "O You whose form is consciousness and joy",
          "hi": "हे वे, चेतना और आनन्द जिनका स्वरूप है"
        },
        "note": {
          "en": "cit 'consciousness' and ānanda 'joy' are first paired ('thought and joy'); the pair is then called the mūrti, the form, of the one addressed, Śiva.",
          "hi": "पहले चित् 'चेतना' और आनन्द 'सुख' की जोड़ी बनती है; फिर इस जोड़ी को सम्बोधित शिव की मूर्ति, यानी स्वरूप, कहा गया है।"
        }
      },
      "c3": {
        "members": [
          "w10"
        ],
        "iast": "tapo-yoga-gamya",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "structure": "((tapas-yoga)-gamya)",
        "vigraha": "तपश्च योगश्च तपोयोगौ, ताभ्यां गम्यः, तत्सम्बुद्धौ",
        "meaning": {
          "en": "O You who are reached through self-discipline and yoga",
          "hi": "हे तप और योग से प्राप्त होने वाले"
        },
        "note": {
          "en": "tapas and yoga are paired ('self-discipline and yoga'), and the pair is the means by which He is gamya, reachable.",
          "hi": "तप और योग की जोड़ी बनती है, और यही वह साधन है जिससे वे गम्य, यानी प्राप्त होने योग्य, हैं।"
        }
      },
      "c4": {
        "members": [
          "w13"
        ],
        "iast": "śruti-jñāna-gamya",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "structure": "((śruti-jñāna)-gamya)",
        "vigraha": "श्रुतेः ज्ञानं श्रुतिज्ञानम्, तेन गम्यः, तत्सम्बुद्धौ",
        "meaning": {
          "en": "O You who are reached through the knowledge of the Vedas",
          "hi": "हे वेदों के ज्ञान से प्राप्त होने वाले"
        },
        "note": {
          "en": "śruti-jñāna 'the knowledge of the Veda' is the means by which He is gamya, reachable. It can also be read as a pair, 'the Veda and knowledge', to match tapo-yoga in the line before.",
          "hi": "श्रुति-ज्ञान 'वेद का ज्ञान' वह साधन है जिससे वे गम्य, यानी प्राप्त होने योग्य, हैं। पिछली पंक्ति के तपो-योग की तरह इसे जोड़ी के रूप में भी पढ़ा जा सकता है: 'वेद और ज्ञान'।"
        }
      }
    },
