  "compounds": {
    "c1": {
      "members": ["w2"],
      "iast": "mahā-īśa",
      "type": "karmadhāraya",
      "vigraha": "महान् ईशः",
      "meaning": {
        "en": "the great Lord",
        "hi": "महान् ईश्वर"
      },
      "note": {
        "en": "mahat 'great' takes the form mahā- at the start of a compound and merges with īśa 'lord': mahā + īśa → maheśa.",
        "hi": "समास के आरम्भ में महत् 'महान्' का रूप महा- होता है, जो ईश 'स्वामी' से मिलकर महेश बनता है: महा + ईश → महेश।"
      }
    },
    "c2": {
      "members": ["w4"],
      "iast": "śūla-pāṇe",
      "type": "bahuvrīhi",
      "subtype": "vyadhikaraṇa",
      "vigraha": "शूलं पाणौ यस्य सः",
      "meaning": {
        "en": "O You who hold the trident in Your hand",
        "hi": "हे हाथ में त्रिशूल धारण करने वाले"
      },
      "note": {
        "en": "'He in whose hand is the trident': the two members are in different relations (śūla is the thing held, pāṇi the place), and the whole names Śiva. Called out here as a name.",
        "hi": "'जिसके हाथ में त्रिशूल है': शूल वस्तु है और पाणि उसका स्थान; पूरा समास शिव का नाम है, जो यहाँ सम्बोधन में आया है।"
      }
    },
    "c3": {
      "members": ["w5"],
      "iast": "gaurī-pate",
      "type": "tatpuruṣa",
      "subtype": "ṣaṣṭhī",
      "vigraha": "गौर्याः पतिः",
      "meaning": {
        "en": "O husband of Gaurī",
        "hi": "हे गौरी के पति"
      },
      "note": {
        "en": "gaurī 'the shining goddess', Pārvatī, + pati 'husband, lord'.",
        "hi": "गौरी 'उज्ज्वल देवी', पार्वती, + पति 'पति, स्वामी'।"
      }
    },
    "c4": {
      "members": ["w6"],
      "iast": "paśu-pate",
      "type": "tatpuruṣa",
      "subtype": "ṣaṣṭhī",
      "vigraha": "पशूनां पतिः",
      "meaning": {
        "en": "O Lord of all beings",
        "hi": "हे सब जीवों के स्वामी"
      },
      "note": {
        "en": "paśu 'a tethered creature, a bound soul' + pati 'lord'. The name opened the hymn in verse 1.",
        "hi": "पशु 'बँधा हुआ प्राणी, बद्ध जीव' + पति 'स्वामी'। स्तोत्र पहले श्लोक में इसी नाम से आरम्भ हुआ था।"
      }
    },
    "c5": {
      "members": ["w7"],
      "iast": "paśu-pāśa-nāśin",
      "type": "tatpuruṣa",
      "subtype": "ṣaṣṭhī",
      "structure": "((paśu-pāśa)-nāśin)",
      "vigraha": "पशूनां पाशः पशुपाशः, पशुपाशानां नाशी",
      "meaning": {
        "en": "O destroyer of the ropes that bind all beings",
        "hi": "हे जीवों के बन्धन नष्ट करने वाले"
      },
      "note": {
        "en": "paśu-pāśa 'the cord of the bound one' is itself a compound; nāśin 'destroyer' (from the causative of √naś, 'to make vanish') takes it as its object.",
        "hi": "पशु-पाश 'बँधे जीव की डोरी' स्वयं एक समास है; नाशिन् 'नष्ट करने वाला' (√नश् के प्रेरणार्थक 'मिटा देना' से) उसे अपना विषय बनाता है।"
      }
    },
    "c6": {
      "members": ["w8"],
      "iast": "kāśī-pate",
      "type": "tatpuruṣa",
      "subtype": "ṣaṣṭhī",
      "vigraha": "काश्याः पतिः",
      "meaning": {
        "en": "O Lord of Kāśī",
        "hi": "हे काशी के स्वामी"
      },
      "note": {
        "en": "kāśī, the city of Vārāṇasī (Benares), + pati 'lord'.",
        "hi": "काशी, यानी वाराणसी नगरी, + पति 'स्वामी'।"
      }
    },
    "c7": {
      "members": ["w15"],
      "iast": "mahā-īśvaraḥ",
      "type": "karmadhāraya",
      "vigraha": "महान् ईश्वरः",
      "meaning": {
        "en": "the great Lord",
        "hi": "महान् ईश्वर"
      },
      "note": {
        "en": "mahā- (from mahat 'great') + īśvara 'lord, ruler'. Only the first part of the display word; asi 'You are' follows it.",
        "hi": "महा- (महत् 'महान्' से) + ईश्वर 'स्वामी, शासक'। यह प्रदर्शित शब्द का केवल पहला भाग है; उसके बाद असि 'आप हैं' आता है।"
      }
    }
  },
