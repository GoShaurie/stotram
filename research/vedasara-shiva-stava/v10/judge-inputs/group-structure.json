    "compounds": {
      "c1": {
        "members": [
          "w2"
        ],
        "iast": "mahā-īśa",
        "type": "karmadhāraya",
        "vigraha": "महान् चासौ ईशः च",
        "meaning": {
          "en": "the great Lord",
          "hi": "महान् ईश्वर"
        },
        "note": {
          "en": "mahat 'great' (as mahā at the front of a compound) describes īśa 'lord'; ā + ī merge into e.",
          "hi": "महत् 'महान्' (समास के आरम्भ में महा) ईश 'स्वामी' का विशेषण है; आ + ई मिलकर ए बनते हैं।"
        }
      },
      "c2": {
        "members": [
          "w4"
        ],
        "iast": "śūla-pāṇe",
        "type": "bahuvrīhi",
        "subtype": "vyadhikaraṇa",
        "vigraha": "शूलं पाणौ यस्य सः",
        "meaning": {
          "en": "He who holds a trident in His hand",
          "hi": "जिनके हाथ में त्रिशूल है"
        },
        "note": {
          "en": "śūla 'trident' and pāṇi 'hand' together describe the one who has the trident in hand, Śiva; here called on directly.",
          "hi": "शूल 'त्रिशूल' और पाणि 'हाथ' मिलकर उनका वर्णन करते हैं जिनके हाथ में त्रिशूल है, अर्थात् शिव; यहाँ उन्हें सीधे पुकारा गया है।"
        }
      },
      "c3": {
        "members": [
          "w5"
        ],
        "iast": "gaurī-pate",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "गौर्याः पतिः",
        "meaning": {
          "en": "husband of Gaurī",
          "hi": "गौरी के पति"
        },
        "note": {
          "en": "gaurī 'Gaurī (Pārvatī)' + pati 'husband': the husband of Gaurī.",
          "hi": "गौरी (पार्वती) + पति: गौरी के पति।"
        }
      },
      "c4": {
        "members": [
          "w6"
        ],
        "iast": "paśu-pate",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "पशूनां पतिः",
        "meaning": {
          "en": "Lord of all beings",
          "hi": "सब जीवों के स्वामी"
        },
        "note": {
          "en": "paśu 'tethered animal, living being' + pati 'lord': the Lord of beings.",
          "hi": "पशु 'बँधा पशु, जीव' + पति 'स्वामी': जीवों के स्वामी।"
        }
      },
      "c5": {
        "members": [
          "w7"
        ],
        "iast": "paśu-pāśa-nāśin",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((paśu-pāśa)-nāśin)",
        "vigraha": "पशूनां पाशाः पशुपाशाः, तेषां नाशी",
        "meaning": {
          "en": "destroyer of the ropes that bind beings",
          "hi": "जीवों के बन्धन नष्ट करने वाले"
        },
        "note": {
          "en": "paśu-pāśa 'the rope of the tethered' is the object of nāśin 'one who destroys'.",
          "hi": "पशु-पाश 'बँधे जीव की रस्सी' नाशिन् 'नष्ट करने वाले' का विषय है।"
        }
      },
      "c6": {
        "members": [
          "w8"
        ],
        "iast": "kāśī-pate",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "काश्याः पतिः",
        "meaning": {
          "en": "Lord of Kāśī",
          "hi": "काशी के स्वामी"
        },
        "note": {
          "en": "kāśī 'Kāśī (Vārāṇasī)' + pati 'lord': the Lord of Kāśī.",
          "hi": "काशी (वाराणसी) + पति 'स्वामी': काशी के स्वामी।"
        }
      },
      "c7": {
        "members": [
          "w15"
        ],
        "iast": "mahā-īśvaraḥ",
        "type": "karmadhāraya",
        "vigraha": "महान् चासौ ईश्वरः च",
        "meaning": {
          "en": "the great Lord",
          "hi": "महान् ईश्वर"
        },
        "note": {
          "en": "mahā 'great' + īśvara 'lord'; ā + ī merge into e, as in maheśa in line 1.",
          "hi": "महा 'महान्' + ईश्वर 'स्वामी'; आ + ई मिलकर ए बनते हैं, जैसे पहली पंक्ति के महेश में।"
        }
      }
    },
