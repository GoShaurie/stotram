        ],
        "iast": "śivā-kānta",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "शिवायाः कान्तः, हे शिवाकान्त",
        "meaning": {
          "en": "O beloved of Śivā (Pārvatī)",
          "hi": "हे शिवा (पार्वती) के प्रियतम"
        },
        "note": {
          "en": "śivā 'Śiva's wife' + kānta 'beloved, husband': the beloved of Śivā.",
          "hi": "शिवा 'शिव की पत्नी' + कान्त 'प्रिय, पति': शिवा के प्रियतम।"
        }
      },
      "c2": {
        "members": [
          "w3"
        ],
        "iast": "śaśāṅk-ārdha-maule",
        "type": "bahuvrīhi",
        "subtype": "vyadhikaraṇa",
        "structure": "((śaśāṅka-ardha)-mauli)",
        "vigraha": "शशाङ्कस्य अर्धः शशाङ्कार्धः, सः मौलौ यस्य सः, हे शशाङ्कार्धमौले",
        "meaning": {
          "en": "O You who have the half-moon on Your head",
          "hi": "हे मस्तक पर अर्धचन्द्र धारण करने वाले"
        },
        "note": {
          "en": "śaśāṅka 'the moon' + ardha 'half' gives 'the half-moon'; mauli 'head, crest' says where it rests. The whole describes Śiva, who wears it.",
          "hi": "शशाङ्क 'चन्द्रमा' + अर्ध 'आधा' से 'अर्धचन्द्र'; मौलि 'मस्तक, शिखा' बताता है कि वह कहाँ है। पूरा समास उन शिव का वर्णन करता है जो उसे धारण करते हैं।"
        }
      },
      "c3": {
        "members": [
          "w4"
        ],
        "iast": "mah-eśāna",
        "type": "karmadhāraya",
        "vigraha": "महान् ईशानः, हे महेशान",
        "meaning": {
          "en": "O great Lord",
          "hi": "हे महान् स्वामी"
        },
        "note": {
          "en": "mahā 'great' + īśāna 'ruler, lord'; a + ī becomes e.",
          "hi": "महा 'महान्' + ईशान 'स्वामी'; आ + ई मिलकर ए बनता है।"
        }
      },
      "c4": {
        "members": [
          "w6"
        ],
        "iast": "jaṭā-jūṭa-dhārin",
        "type": "upapada",
        "structure": "((jaṭā-jūṭa)-dhārin)",
        "vigraha": "जटानां जूटः जटाजूटः, तं धारयति इति, हे जटाजूटधारिन्",
        "meaning": {
          "en": "O wearer of the coil of matted hair",
          "hi": "हे जटाजूट धारण करने वाले"
        },
        "note": {
          "en": "jaṭā 'matted hair' + jūṭa 'twisted knot' gives the piled-up coil of locks; dhārin 'one who wears' takes it as what is worn.",
          "hi": "जटा 'उलझे केश' + जूट 'बँधा हुआ जूड़ा' से जटाओं का ऊँचा जूड़ा; धारिन् 'धारण करने वाला' उसे वह बताता है जो धारण किया गया है।"
        }
      },
      "c5": {
        "members": [
          "w8"
        ],
        "iast": "jagad-vyāpako",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "जगतः व्यापकः",
        "meaning": {
          "en": "the one who spreads through the world",
          "hi": "जगत् में व्याप्त"
        },
        "note": {
          "en": "jagat 'the world' + vyāpaka 'spreading through, filling'.",
          "hi": "जगत् 'संसार' + व्यापक 'फैला हुआ, भरा हुआ'।"
        }
      },
      "c6": {
        "members": [
          "w9"
        ],
        "iast": "viśva-rūpaḥ",
        "type": "bahuvrīhi",
        "vigraha": "विश्वं रूपं यस्य सः",
        "meaning": {
          "en": "He whose form is the universe",
          "hi": "जिनका रूप सारा विश्व है"
        },
        "note": {
          "en": "viśva 'all, the universe' + rūpa 'form'; the compound describes the one who has such a form.",
          "hi": "विश्व 'सब, संसार' + रूप 'आकार'; समास उसका वर्णन करता है जिसका ऐसा रूप है।"
        }
      },
      "c7": {
        "members": [
          "w13"
        ],
        "iast": "pūrṇa-rūpa",
        "type": "bahuvrīhi",
        "vigraha": "पूर्णं रूपं यस्य सः, हे पूर्णरूप",
        "meaning": {
          "en": "O You whose form is whole",
          "hi": "हे पूर्ण रूप वाले"
        },
        "note": {
          "en": "pūrṇa 'full, whole' + rūpa 'form'; the compound names Śiva by the form He has.",
          "hi": "पूर्ण 'भरा हुआ, सम्पूर्ण' + रूप 'आकार'; समास शिव को उनके रूप से पुकारता है।"
        }
      }
    },
