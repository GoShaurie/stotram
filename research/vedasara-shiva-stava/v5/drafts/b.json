  "translations": {
    "en": {
      "lines": [
        [
          {
            "refs": [
              "w1"
            ],
            "text": "The supreme Self, the One,"
          },
          {
            "refs": [
              "w2"
            ],
            "text": "the first seed of the world,"
          }
        ],
        [
          {
            "refs": [
              "w3"
            ],
            "text": "free of desire,"
          },
          {
            "refs": [
              "w4"
            ],
            "text": "formless, known through Oṃ;"
          }
        ],
        [
          {
            "refs": [
              "w5"
            ],
            "text": "from whom"
          },
          {
            "refs": [
              "w9"
            ],
            "text": "the universe"
          },
          {
            "refs": [
              "w6"
            ],
            "text": "is born,"
          },
          {
            "refs": [
              "w8"
            ],
            "text": "by whom"
          },
          {
            "refs": [
              "w9"
            ],
            "text": "it"
          },
          {
            "refs": [
              "w7"
            ],
            "text": "is kept:"
          }
        ],
        [
          {
            "refs": [
              "w10"
            ],
            "text": "that Lord"
          },
          {
            "refs": [
              "x1"
            ],
            "text": "I"
          },
          {
            "refs": [
              "w11"
            ],
            "text": "worship,"
          },
          {
            "refs": [
              "w13"
            ],
            "text": "in whom"
          },
          {
            "refs": [
              "w14"
            ],
            "text": "the universe"
          },
          {
            "refs": [
              "w12"
            ],
            "text": "dissolves."
          }
        ]
      ],
      "bhavartha": "The poet worships the Lord who is the supreme Self, the One, the first seed of the world. He wants nothing, has no form, and is known through the syllable Oṃ. The universe is born from Him, is kept by Him, and dissolves in Him."
    },
    "hi": {
      "lines": [
        [
          {
            "refs": [
              "w1"
            ],
            "text": "परमात्मा, एक,"
          },
          {
            "refs": [
              "w2"
            ],
            "text": "जगत् के आदि-बीज,"
          }
        ],
        [
          {
            "refs": [
              "w3"
            ],
            "text": "इच्छा से रहित,"
          },
          {
            "refs": [
              "w4"
            ],
            "text": "निराकार, ओंकार से जानने योग्य;"
          }
        ],
        [
          {
            "refs": [
              "w5"
            ],
            "text": "जिनसे"
          },
          {
            "refs": [
              "w9"
            ],
            "text": "विश्व"
          },
          {
            "refs": [
              "w6"
            ],
            "text": "जन्म लेता है,"
          },
          {
            "refs": [
              "w8"
            ],
            "text": "जिनके द्वारा"
          },
          {
            "refs": [
              "w9"
            ],
            "text": "वह"
          },
          {
            "refs": [
              "w7"
            ],
            "text": "पाला जाता है,"
          }
        ],
        [
          {
            "refs": [
              "w13"
            ],
            "text": "जिनमें"
          },
          {
            "refs": [
              "w14"
            ],
            "text": "विश्व"
          },
          {
            "refs": [
              "w12"
            ],
            "text": "लीन होता है,"
          },
          {
            "refs": [
              "w10"
            ],
            "text": "उन ईश्वर को"
          },
          {
            "refs": [
              "x1"
            ],
            "text": "मैं"
          },
          {
            "refs": [
              "w11"
            ],
            "text": "भजता हूँ।"
          }
        ]
      ],
      "bhavartha": "कवि उन ईश्वर को भजता है जो परमात्मा हैं, एक हैं और जगत् के आदि-बीज हैं। उन्हें कोई इच्छा नहीं, उनका कोई आकार नहीं, और वे ओंकार के द्वारा जाने जाते हैं। विश्व उनसे जन्म लेता है, उनके द्वारा पाला जाता है और उनमें लीन हो जाता है।"
    }
