  "compounds": {
    "c1": {
      "members": [
        "w1"
      ],
      "iast": "para-ātmānam",
      "type": "karmadhāraya",
      "vigraha": "परः आत्मा",
      "meaning": {
        "en": "the supreme Self",
        "hi": "परम आत्मा, परमात्मा"
      },
      "note": {
        "en": "para 'highest' qualifies ātman 'self'; the two a-sounds merge into one long ā: para + ātman → parātman. Only the first part of the display word परात्मानमेकं is this compound; ekam is a separate word joined to it in writing.",
        "hi": "पर 'सर्वोच्च' आत्मन् 'आत्मा' का विशेषण है; दोनों 'अ' मिलकर एक दीर्घ 'आ' बनते हैं: पर + आत्मन् → परात्मन्। प्रदर्शित शब्द परात्मानमेकं का केवल पहला भाग यह समास है; एकम् अलग शब्द है जो लिखावट में साथ जुड़ा है।"
      }
    },
    "c2": {
      "members": [
        "w2"
      ],
      "iast": "jagad-bījam",
      "type": "tatpuruṣa",
      "subtype": "ṣaṣṭhī",
      "vigraha": "जगतः बीजम्",
      "meaning": {
        "en": "the seed of the world",
        "hi": "जगत् का बीज"
      },
      "note": {
        "en": "jagat 'world' + bīja 'seed'; final t becomes d before b. The dictionary records jagad-bīja, 'world-seed', as a name of Śiva. ādyam, 'first', is a separate word written joined to it.",
        "hi": "जगत् 'संसार' + बीज; 'ब' से पहले अन्तिम 'त्' 'द्' बन जाता है। कोश में जगद्-बीज, 'संसार का बीज', शिव का नाम है। आद्यम्, 'पहला', अलग शब्द है जो लिखावट में साथ जुड़ा है।"
      }
    },
    "c3": {
      "members": [
        "w3"
      ],
      "iast": "nir-īham",
      "type": "bahuvrīhi",
      "subtype": "prādi",
      "vigraha": "निर्गता ईहा यस्मात् सः, तम्",
      "meaning": {
        "en": "Him from whom all wanting has gone",
        "hi": "उन (शिव) को, जिनमें कोई इच्छा नहीं"
      },
      "note": {
        "en": "nir 'without, away' + īhā 'desire, effort'. The compound describes the person who has no desire, Śiva, and so takes the masculine form nirīham like the other descriptions.",
        "hi": "निर् 'रहित' + ईहा 'इच्छा, चेष्टा'। समास उस व्यक्ति का वर्णन करता है जिसमें इच्छा नहीं, अर्थात् शिव, इसलिए बाकी विशेषणों की तरह पुंलिंग रूप निरीहम् में है।"
      }
    },
    "c4": {
      "members": [
        "w4"
      ],
      "iast": "nir-ākāram",
      "type": "bahuvrīhi",
      "subtype": "prādi",
      "vigraha": "निर्गतः आकारः यस्मात् सः, तम्",
      "meaning": {
        "en": "Him who has no form",
        "hi": "उन (शिव) को, जिनका कोई आकार नहीं"
      },
      "note": {
        "en": "nir 'without' + ākāra 'form, shape'. The first part of the display word निराकारमोङ्कारवेद्यम्; the second compound, oṅkāra-vedyam, follows it.",
        "hi": "निर् 'रहित' + आकार 'रूप, आकृति'। प्रदर्शित शब्द निराकारमोङ्कारवेद्यम् का पहला भाग; दूसरा समास, ओङ्कार-वेद्यम्, इसके बाद आता है।"
      }
    },
    "c5": {
      "members": [
        "w4"
      ],
      "iast": "oṅkāra-vedyam",
      "type": "tatpuruṣa",
      "subtype": "tṛtīyā",
      "vigraha": "ओङ्कारेण वेद्यः, तम्",
      "meaning": {
        "en": "Him who is to be known through Oṃ",
        "hi": "उन (शिव) को, जो ओंकार से जाने जाते हैं"
      },
      "note": {
        "en": "oṅkāra 'the syllable Oṃ' gives the means; vedya 'to be known' (from √vid) is the result: known by means of Oṃ. Inside oṅkāra, the m of om becomes ṅ before k.",
        "hi": "ओङ्कार 'ॐ अक्षर' साधन है; वेद्य 'जानने योग्य' (√विद् से) परिणाम: ॐ के द्वारा जाने जाने योग्य। ओङ्कार के भीतर 'क' से पहले ओम् का 'म्' 'ङ्' बन जाता है।"
      }
    }
  },
