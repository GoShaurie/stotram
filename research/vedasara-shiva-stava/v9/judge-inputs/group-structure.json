    "compounds": {
      "c1": {
        "members": [
          "w2"
        ],
        "iast": "śūla-pāṇe",
        "type": "bahuvrīhi",
        "subtype": "vyadhikaraṇa",
        "vigraha": "शूलं पाणौ यस्य सः",
        "meaning": {
          "en": "He who holds a trident in His hand",
          "hi": "जिनके हाथ में त्रिशूल है"
        },
        "note": {
          "en": "śūla 'trident' + pāṇi 'hand': the one in whose hand the trident is. Used here as a name, in the form for calling out (-e).",
          "hi": "शूल 'त्रिशूल' + पाणि 'हाथ': जिनके हाथ में त्रिशूल है। यहाँ नाम की तरह, पुकार के रूप (-ए) में।"
        }
      },
      "c2": {
        "members": [
          "w4"
        ],
        "iast": "viśva-nātha",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "विश्वस्य नाथः",
        "meaning": {
          "en": "Lord of the universe",
          "hi": "विश्व के स्वामी"
        },
        "note": {
          "en": "viśva 'all, the universe' + nātha 'protector, lord'.",
          "hi": "विश्व 'सब, संसार' + नाथ 'रक्षक, स्वामी'।"
        }
      },
      "c3": {
        "members": [
          "w5"
        ],
        "iast": "mahā-deva",
        "type": "karmadhāraya",
        "vigraha": "महान् देवः",
        "meaning": {
          "en": "the great God",
          "hi": "महान् देव"
        },
        "note": {
          "en": "mahat 'great' takes the form mahā- at the head of a compound when it describes the second member.",
          "hi": "समास के आरम्भ में विशेषण 'महत्' का रूप 'महा-' हो जाता है।"
        }
      },
      "c4": {
        "members": [
          "w7"
        ],
        "iast": "mahā-īśa",
        "type": "karmadhāraya",
        "vigraha": "महान् ईशः",
        "meaning": {
          "en": "the great Lord",
          "hi": "महान् ईश्वर"
        },
        "note": {
          "en": "mahā- + īśa 'lord'; ā + ī merge into e: maheśa.",
          "hi": "महा- + ईश 'स्वामी'; आ + ई मिलकर ए: महेश।"
        }
      },
      "c5": {
        "members": [
          "w8"
        ],
        "iast": "tri-netra",
        "type": "bahuvrīhi",
        "vigraha": "त्रीणि नेत्राणि यस्य सः",
        "meaning": {
          "en": "He who has three eyes",
          "hi": "जिनके तीन नेत्र हैं"
        },
        "note": {
          "en": "tri 'three' + netra 'eye': the one who has three eyes. Used as a name.",
          "hi": "त्रि 'तीन' + नेत्र 'आँख': जिनकी तीन आँखें हैं। नाम की तरह प्रयुक्त।"
        }
      },
      "c6": {
        "members": [
          "w9"
        ],
        "iast": "śivā-kānta",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "शिवायाः कान्तः",
        "meaning": {
          "en": "beloved of Śivā (Pārvatī)",
          "hi": "शिवा (पार्वती) के प्रियतम"
        },
        "note": {
          "en": "śivā (long ā) 'Śiva's wife' + kānta 'beloved, husband'.",
          "hi": "शिवा (दीर्घ आ) 'शिव की पत्नी' + कान्त 'प्रियतम, पति'।"
        }
      },
      "c7": {
        "members": [
          "w11"
        ],
        "iast": "smara-ari",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "स्मरस्य अरिः",
        "meaning": {
          "en": "enemy of Smara (Kāma)",
          "hi": "स्मर (कामदेव) के शत्रु"
        },
        "note": {
          "en": "smara 'Kāma, god of love' + ari 'enemy'; a + a merge into ā: smarāri.",
          "hi": "स्मर 'कामदेव' + अरि 'शत्रु'; अ + अ मिलकर आ: स्मरारि।"
        }
      },
      "c8": {
        "members": [
          "w12"
        ],
        "iast": "pura-ari",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "पुराणाम् अरिः",
        "meaning": {
          "en": "enemy of the (three) cities",
          "hi": "(तीनों) पुरों के शत्रु"
        },
        "note": {
          "en": "pura 'fortress, city' + ari 'enemy'; a + a merge into ā: purāri.",
          "hi": "पुर 'गढ़, नगर' + अरि 'शत्रु'; अ + अ मिलकर आ: पुरारि।"
        }
      },
      "c9": {
        "members": [
          "w13"
        ],
        "iast": "tvad-anyo",
        "type": "tatpuruṣa",
        "subtype": "pañcamī",
        "vigraha": "त्वत्तः अन्यः",
        "meaning": {
          "en": "one other than You",
          "hi": "आपसे भिन्न कोई"
        },
        "note": {
          "en": "tvad, the compound form of 'you' (one person), + anya 'other than': other than You.",
          "hi": "त्वद् ('तुम' का समास-रूप, एकवचन) + अन्य 'से भिन्न': आपसे भिन्न।"
        }
      }
    },
