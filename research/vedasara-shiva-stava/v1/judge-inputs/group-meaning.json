  "stotram": {
    "id": "vedasara-shiva-stava",
    "title": {
      "sa": "वेदसारशिवस्तवः",
      "iast": "Vedasāraśivastavaḥ",
      "en": "Vedasara Shiva Stava",
      "hi": "वेदसार शिव स्तव"
    },
    "deities": [
      "shiva"
    ],
    "tradition": {
      "id": "shaiva"
    }
  },
  "verse": {
    "id": "v1",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "पशूनां",
            "iast": "paśūnāṃ"
          },
          {
            "id": "w2",
            "text": "पतिं",
            "iast": "patiṃ"
          },
          {
            "id": "w3",
            "text": "पापनाशं",
            "iast": "pāpanāśaṃ"
          },
          {
            "id": "w4",
            "text": "परेशं",
            "iast": "pareśaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w5",
            "text": "गजेन्द्रस्य",
            "iast": "gajendrasya"
          },
          {
            "id": "w6",
            "text": "कृत्तिं",
            "iast": "kṛttiṃ"
          },
          {
            "id": "w7",
            "text": "वसानं",
            "iast": "vasānaṃ"
          },
          {
            "id": "w8",
            "text": "वरेण्यम्",
            "iast": "vareṇyam"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w9",
            "text": "जटाजूट",
            "iast": "jaṭājūṭa"
          },
          {
            "id": "w10",
            "text": "मध्ये",
            "iast": "madhye"
          },
          {
            "id": "w11",
            "text": "स्फुरद्गाङ्गवारिं",
            "iast": "sphuradgāṅgavāriṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w12",
            "text": "महादेवमेकं",
            "iast": "mahādevamekaṃ"
          },
          {
            "id": "w13",
            "text": "स्मरामि",
            "iast": "smarāmi"
          },
          {
            "id": "w14",
            "text": "स्मरारिम्",
            "iast": "smarārim"
          }
        ],
        "end": "॥ १ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w3"
        ],
        "iast": "pāpa-nāśaṃ",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "पापानां नाशः",
        "meaning": {
          "en": "the destroyer of sins",
          "hi": "पापों का नाश करने वाले"
        },
        "note": {
          "en": "nāśa 'destruction' at the end of a compound means 'destroying'; so pāpa-nāśa is the one who destroys sins. It describes Śiva and stands in the accusative like the other descriptions.",
          "hi": "समास के अन्त में नाश का अर्थ 'नाश करने वाला' होता है; इसलिए पाप-नाश वह है जो पापों का नाश करता है। यह शिव का विशेषण है और बाकी विशेषणों की तरह द्वितीया में है।"
        }
      },
      "c2": {
        "members": [
          "w4"
        ],
        "iast": "para-īśaṃ",
        "type": "karmadhāraya",
        "vigraha": "परः ईशः",
        "meaning": {
          "en": "the highest Lord",
          "hi": "परम ईश्वर"
        },
        "note": {
          "en": "para 'highest' qualifies īśa 'lord'; a + ī merge into e (guṇa): para + īśa → pareśa.",
          "hi": "पर 'सर्वोच्च' ईश 'स्वामी' का विशेषण है; अ + ई मिलकर ए (गुण) बनते हैं: पर + ईश → परेश।"
        }
      },
      "c3": {
        "members": [
          "w5"
        ],
        "iast": "gaja-indrasya",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "गजानाम् इन्द्रः",
        "meaning": {
          "en": "of the king of elephants",
          "hi": "गजराज की"
        },
        "note": {
          "en": "indra at the end of a compound means 'chief, best of its kind'; gaja-indra is the chief among elephants. a + i merge into e (guṇa).",
          "hi": "समास के अन्त में इन्द्र का अर्थ 'श्रेष्ठ, प्रधान' है; गज-इन्द्र यानी हाथियों में श्रेष्ठ। अ + इ मिलकर ए (गुण) बनते हैं।"
        }
      },
      "c4": {
        "members": [
          "w9",
          "w10"
        ],
        "iast": "jaṭā-jūṭa-madhye",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((jaṭā-jūṭa)-madhya)",
        "vigraha": "जटानां जूटः जटाजूटः, तस्य मध्ये",
        "meaning": {
          "en": "in the middle of the coil of matted hair",
          "hi": "जटाजूट के बीच में"
        },
        "note": {
          "en": "jaṭā-jūṭa is the long matted hair twisted into a knot on top of the head; madhya 'middle' closes the compound, and its ending -e means 'in'. The text prints jaṭājūṭa and madhye as two display words, but they form one compound.",
          "hi": "जटा-जूट सिर के ऊपर गाँठ में बँधी लम्बी जटाएँ हैं; मध्य 'बीच' समास को पूरा करता है, और उसका अन्त '-ए' 'में' का अर्थ देता है। पाठ में जटाजूट और मध्ये अलग छपे हैं, पर दोनों एक ही समास हैं।"
        }
      },
      "c5": {
        "members": [
          "w11"
        ],
        "iast": "sphurad-gāṅga-vāriṃ",
        "type": "bahuvrīhi",
        "structure": "(sphurat-(gāṅga-vāri))",
        "vigraha": "स्फुरत् गाङ्गं वारि यस्य सः, तम्",
        "meaning": {
          "en": "Him whose Gaṅgā water sparkles (in His matted hair)",
          "hi": "उन (शिव) को, जिनकी (जटाओं में) गंगाजल झिलमिलाता है"
        },
        "note": {
          "en": "sphurat 'sparkling, quivering' and gāṅga 'of the Gaṅgā' both describe vāri 'water'. As a bahuvrīhi the whole describes Śiva, the one who has such water, so it takes the masculine accusative vārim. The place word jaṭājūṭa-madhye stands outside the compound but tells where the water sparkles.",
          "hi": "स्फुरत् 'झिलमिलाता, थिरकता' और गाङ्ग 'गंगा का', दोनों वारि 'जल' के विशेषण हैं। बहुव्रीहि होने से पूरा समास शिव का वर्णन करता है, जिनके पास ऐसा जल है, इसलिए यह पुंलिंग द्वितीया 'वारिम्' में है। स्थान-सूचक जटाजूटमध्ये समास के बाहर है, पर बताता है कि जल कहाँ झिलमिलाता है।"
        }
      },
      "c6": {
        "members": [
          "w12"
        ],
        "iast": "mahā-devam",
        "type": "karmadhāraya",
        "vigraha": "महान् देवः",
        "meaning": {
          "en": "the Great God",
          "hi": "महान देव"
        },
        "note": {
          "en": "mahat 'great' takes the form mahā at the start of a compound. Only the first part of the display word महादेवमेकं is this compound; ekam is a separate word joined to it in writing.",
          "hi": "समास के आरम्भ में महत् 'महान' का रूप महा हो जाता है। प्रदर्शित शब्द महादेवमेकं का केवल पहला भाग यह समास है; एकम् अलग शब्द है जो लिखावट में साथ जुड़ा है।"
        }
      },
      "c7": {
        "members": [
          "w14"
        ],
        "iast": "smara-arim",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "स्मरस्य अरिः",
        "meaning": {
          "en": "the enemy of Smara (Kāma)",
          "hi": "स्मर (कामदेव) के शत्रु"
        },
        "note": {
          "en": "smara + ari: the two a's merge into one long ā (savarṇa-dīrgha), smarāri. The dictionary gives it as equal to smara-śatru, 'foe of Kāma'.",
          "hi": "स्मर + अरि: दोनों 'अ' मिलकर एक दीर्घ 'आ' बनते हैं (सवर्णदीर्घ), स्मरारि। कोश इसे स्मर-शत्रु, 'काम का शत्रु', के समान बताता है।"
        }
      }
    },
