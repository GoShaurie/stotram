      ],
      "iast": "śiva-sannidhau",
      "type": "tatpuruṣa",
      "subtype": "ṣaṣṭhī",
      "vigraha": "शिवस्य सन्निधौ",
      "meaning": {
        "en": "in Śiva's presence, near Śiva",
        "hi": "शिव के सान्निध्य में, शिव के समीप"
      },
      "note": {
        "en": "śiva + sannidhi 'nearness, presence'; the first member says whose presence. The -au ending of sannidhi means 'in, at'.",
        "hi": "शिव + सन्निधि 'निकटता, उपस्थिति'; पहला पद बताता है कि किसकी उपस्थिति। सन्निधि का '-औ' अन्त 'में, पर' का अर्थ देता है।"
      }
    },
