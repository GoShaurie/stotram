  "words": {
    "w1": {
      "compound": "c1",
      "padaccheda": [
        {
          "sa": "पञ्च",
          "iast": "pañca"
        },
        {
          "sa": "अक्षरम्",
          "iast": "akṣaram"
        },
        {
          "sa": "इदम्",
          "iast": "idam"
        }
      ],
      "sandhi": [
        {
          "name": "savarṇa-dīrgha",
          "rule": "a + a → ā",
          "explanation": {
            "en": "The final a of pañca and the first a of akṣara merge into one long ā: pañca + akṣara → pañcākṣara.",
            "hi": "पञ्च का अन्तिम 'अ' और अक्षर का पहला 'अ' मिलकर एक दीर्घ 'आ' बन जाते हैं: पञ्च + अक्षर → पञ्चाक्षर।"
          }
        },
        {
          "name": "anusvāra",
          "rule": "m + consonant → ṃ",
