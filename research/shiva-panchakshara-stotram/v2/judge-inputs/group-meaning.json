  "verse": {
    "id": "v2",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "मन्दाकिनीसलिलचन्दनचर्चिताय",
            "iast": "mandākinīsalilacandanacarcitāya"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w2",
            "text": "नन्दीश्वरप्रमथनाथमहेश्वराय",
            "iast": "nandīśvarapramathanāthamaheśvarāya"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w3",
            "text": "मन्दारपुष्पबहुपुष्पसुपूजिताय",
            "iast": "mandārapuṣpabahupuṣpasupūjitāya"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w4",
            "text": "तस्मै",
            "iast": "tasmai"
          },
          {
            "id": "w5",
            "text": "मकाराय",
            "iast": "makārāya"
          },
          {
            "id": "w6",
            "text": "नमः",
            "iast": "namaḥ"
          },
          {
            "id": "w7",
            "text": "शिवाय",
            "iast": "śivāya"
          }
        ],
        "end": "॥ २ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w1"
        ],
        "iast": "mandākinī-salila-candana-carcitāya",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "structure": "(((mandākinī-salila)-candana)-carcita)",
        "vigraha": "मन्दाकिन्याः सलिलं च चन्दनं च मन्दाकिनीसलिलचन्दने, ताभ्यां चर्चितः, तस्मै",
        "meaning": {
          "en": "to Him who is anointed with the water of the Mandākinī and with sandal paste",
          "hi": "उन (शिव) को, जिन पर मन्दाकिनी का जल और चन्दन लगाया गया है"
        },
        "note": {
          "en": "mandākinī-salila 'the water of the Mandākinī' and candana 'sandal paste' are paired; carcita 'anointed with' says what they do to Him. The whole describes Śiva.",
          "hi": "मन्दाकिनी-सलिल 'मन्दाकिनी का जल' और चन्दन 'चन्दन का लेप' जोड़े में हैं; चर्चित 'लिपा हुआ' बताता है कि वे उन पर लगे हैं। पूरा समास शिव का वर्णन करता है।"
        }
      },
      "c2": {
        "members": [
          "w2"
        ],
        "iast": "nandi-īśvara-pramatha-nātha-mahā-īśvarāya",
        "type": "karmadhāraya",
        "structure": "((nandin-īśvara)-(pramatha-nātha)-(mahat-īśvara))",
        "vigraha": "नन्दिनः ईश्वरः नन्दीश्वरः, प्रमथानां नाथः प्रमथनाथः, महान् ईश्वरः महेश्वरः; नन्दीश्वरः प्रमथनाथः महेश्वरः च सः, तस्मै",
        "meaning": {
          "en": "to Him who is the Lord of Nandī, the master of the pramathas and the great Lord",
          "hi": "उन (शिव) को, जो नन्दी के स्वामी, प्रमथगणों के नाथ और महेश्वर हैं"
        },
        "note": {
          "en": "Three titles of the same person joined into one word: nandi-īśvara 'Lord of Nandī', pramatha-nātha 'master of the pramathas', mahā-īśvara 'the great Lord'. Only the last carries the 'to' ending for all three.",
          "hi": "एक ही व्यक्ति की तीन उपाधियाँ एक शब्द में जुड़ी हैं: नन्दि-ईश्वर 'नन्दी के स्वामी', प्रमथ-नाथ 'प्रमथों के नाथ', महा-ईश्वर 'महान् ईश्वर'। 'को' वाला अन्त केवल अन्तिम पद पर है, पर तीनों के लिए है।"
        }
      },
      "c3": {
        "members": [
          "w3"
        ],
        "iast": "mandāra-puṣpa-bahu-puṣpa-su-pūjitāya",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "structure": "(((mandāra-puṣpa)-(bahu-puṣpa))-(su-pūjita))",
        "vigraha": "मन्दारस्य पुष्पाणि च बहूनि पुष्पाणि च, तैः सुपूजितः, तस्मै",
        "meaning": {
          "en": "to Him who is well worshipped with mandāra flowers and many other flowers",
          "hi": "उन (शिव) को, जिनकी मन्दार के फूलों और अनेक अन्य फूलों से भली-भाँति पूजा हुई है"
        },
        "note": {
          "en": "mandāra-puṣpa 'mandāra flowers' and bahu-puṣpa 'many flowers' are paired; su-pūjita 'well worshipped' says what was done with them.",
          "hi": "मन्दार-पुष्प 'मन्दार के फूल' और बहु-पुष्प 'बहुत-से फूल' जोड़े में हैं; सु-पूजित 'भली-भाँति पूजित' बताता है कि उनसे क्या किया गया।"
        }
      }
    },
