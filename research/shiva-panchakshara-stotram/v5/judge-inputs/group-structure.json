        "iast": "yakṣa-svarūpāya",
        "type": "bahuvrīhi",
        "vigraha": "यक्षः स्वरूपं यस्य सः, तस्मै",
        "meaning": {
          "en": "to Him whose form is a yakṣa",
          "hi": "उन (शिव) को, जिनका स्वरूप यक्ष का है"
        },
        "note": {
          "en": "yakṣa 'a spirit-being' + svarūpa 'own form': the one whose form is a yakṣa, i.e. Śiva.",
          "hi": "यक्ष 'अलौकिक प्राणी' + स्वरूप 'अपना रूप': जिनका रूप यक्ष का है, अर्थात् शिव।"
        }
      },
      "c2": {
        "members": [
          "w2"
        ],
        "iast": "jaṭā-dharāya",
        "type": "upapada",
        "vigraha": "जटाः धरति इति जटाधरः, तस्मै",
        "meaning": {
          "en": "to Him who wears matted hair",
          "hi": "जटा धारण करने वाले को"
        },
        "note": {
          "en": "jaṭā 'matted hair' + dhara 'wearing' (from √dhṛ 'to hold'): the one who wears matted hair.",
          "hi": "जटा 'उलझे केश' + धर 'धारण करने वाला' (√धृ 'धारण करना' से): जो जटा धारण करते हैं।"
        }
      },
      "c3": {
        "members": [
          "w3"
        ],
        "iast": "pināka-hastāya",
        "type": "bahuvrīhi",
        "vigraha": "पिनाकः हस्ते यस्य सः, तस्मै",
        "meaning": {
          "en": "to Him in whose hand is the Pināka bow",
          "hi": "उन (शिव) को, जिनके हाथ में पिनाक है"
        },
        "note": {
          "en": "pināka 'Śiva's bow' + hasta 'hand': the one who has the Pināka in His hand.",
          "hi": "पिनाक 'शिव का धनुष' + हस्त 'हाथ': जिनके हाथ में पिनाक है।"
        }
      },
      "c4": {
        "members": [
          "w7"
        ],
        "iast": "dig-ambarāya",
        "type": "bahuvrīhi",
        "vigraha": "दिशः एव अम्बरं यस्य सः, तस्मै",
        "meaning": {
          "en": "to Him whose clothing is the directions",
          "hi": "उन (शिव) को, दिशाएँ ही जिनके वस्त्र हैं"
        },
        "note": {
          "en": "diś 'direction' + ambara 'clothing' (also 'sky'): the one clothed only in the directions, i.e. naked. The same word as in verse 1.",
          "hi": "दिश् 'दिशा' + अम्बर 'वस्त्र' (और 'आकाश'): जो केवल दिशाओं को ओढ़े हैं, अर्थात् निर्वस्त्र। पहले श्लोक वाला ही शब्द।"
        }
      }
    },
