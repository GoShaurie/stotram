    "id": "kalabhairava-ashtakam",
    "title": {
      "sa": "कालभैरवाष्टकम्",
      "iast": "Kālabhairavāṣṭakam",
      "en": "Kalabhairava Ashtakam",
      "hi": "कालभैरवाष्टकम्"
    },
    "deities": [
      "kalabhairava",
      "shiva"
    ],
    "tradition": {
      "id": "shaiva"
    }
