  "verse": {
    "id": "v7",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "अट्टहासभिन्नपद्मजाण्डकोशसन्ततिं",
            "iast": "aṭṭahāsabhinnapadmajāṇḍakośasantatiṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w2",
            "text": "दृष्टिपातनष्टपापजालमुग्रशासनम्",
            "iast": "dṛṣṭipātanaṣṭapāpajālamugraśāsanam"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w3",
            "text": "अष्टसिद्धिदायकं",
            "iast": "aṣṭasiddhidāyakaṃ"
          },
          {
            "id": "w4",
            "text": "कपालमालिकाधरं",
            "iast": "kapālamālikādharaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w5",
            "text": "काशिकापुराधिनाथ",
            "iast": "kāśikāpurādhinātha"
          },
          {
            "id": "w6",
            "text": "कालभैरवं",
            "iast": "kālabhairavaṃ"
          },
          {
            "id": "w7",
            "text": "भजे",
            "iast": "bhaje"
          }
        ],
        "end": "॥ ७ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w1"
        ],
        "iast": "aṭṭa-hāsa-bhinna-padma-ja-aṇḍa-kośa-santatim",
        "type": "bahuvrīhi",
        "structure": "(((aṭṭa-hāsa)-bhinna)-((((padma-ja)-aṇḍa)-kośa)-santati))",
        "vigraha": "अट्टहासेन भिन्ना पद्मजस्य अण्डानां कोशानां सन्ततिः येन सः, तम्",
        "meaning": {
          "en": "Him by whose loud laugh the endless row of shells of the world-eggs of lotus-born Brahmā is split",
          "hi": "उन्हें, जिनके अट्टहास से कमल से जन्मे ब्रह्मा के ब्रह्माण्डों के खोलों की पूरी पंक्ति फट जाती है"
        },
        "note": {
          "en": "aṭṭa-hāsa 'loud laugh' is what does the splitting (bhinna, 'split'); padmaja 'the lotus-born' is Brahmā, and his aṇḍa 'egg' is the world-egg; kośa is its shell; santati is a long unbroken row of them. The whole describes Kālabhairava, the one whose laugh does this, and so takes his ending.",
          "hi": "अट्ट-हास 'ज़ोर की हँसी' वह है जिससे सब फटता है (भिन्न, 'फटा हुआ'); पद्मज 'कमल से जन्मे' ब्रह्मा हैं, और उनका अण्ड ब्रह्माण्ड है; कोश उसका खोल है; सन्तति उनकी लम्बी, अटूट पंक्ति है। पूरा समास उन कालभैरव का वर्णन करता है जिनकी हँसी ऐसा करती है।"
        }
      },
      "c2": {
        "members": [
          "w2"
        ],
        "iast": "dṛṣṭi-pāta-naṣṭa-pāpa-jālam",
        "type": "bahuvrīhi",
        "structure": "(((dṛṣṭi-pāta)-naṣṭa)-(pāpa-jāla))",
        "vigraha": "दृष्टिपातेन नष्टं पापजालं येन सः, तम्",
        "meaning": {
          "en": "Him by the fall of whose glance the net of sins is destroyed",
          "hi": "उन्हें, जिनकी दृष्टि पड़ते ही पापों का जाल नष्ट हो जाता है"
        },
        "note": {
          "en": "dṛṣṭi-pāta 'the falling of the glance' is the cause; naṣṭa 'destroyed' is what happens; pāpa-jāla 'the net of sins' is what is destroyed. The first of two descriptions packed into the display word w2.",
          "hi": "दृष्टि-पात 'दृष्टि का पड़ना' कारण है; नष्ट 'नष्ट हुआ' परिणाम है; पाप-जाल 'पापों का जाल' वह है जो नष्ट होता है। w2 में जुड़े दो वर्णनों में पहला।"
        }
      },
      "c3": {
        "members": [
          "w2"
        ],
        "iast": "ugra-śāsanam",
        "type": "bahuvrīhi",
        "vigraha": "उग्रं शासनं यस्य सः, तम्",
        "meaning": {
          "en": "Him whose rule is stern",
          "hi": "उन्हें, जिनका शासन कठोर है"
        },
        "note": {
          "en": "ugra 'fierce, stern' + śāsana 'rule, command': the one whose rule is stern. The second description in w2.",
          "hi": "उग्र 'प्रचण्ड, कठोर' + शासन 'शासन, आज्ञा': जिनका शासन कठोर है। w2 का दूसरा वर्णन।"
        }
      },
      "c4": {
        "members": [
          "w3"
        ],
        "iast": "aṣṭa-siddhi-dāyakam",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((aṣṭa-siddhi)-dāyaka)",
        "vigraha": "अष्टानां सिद्धीनां दायकः, तम्",
        "meaning": {
          "en": "the giver of the eight powers",
          "hi": "आठों सिद्धियों के दाता"
        },
        "note": {
          "en": "aṣṭa-siddhi 'the eight powers' is what is given; dāyaka 'giver' is the one who gives them.",
          "hi": "अष्ट-सिद्धि 'आठ सिद्धियाँ' वे हैं जो दी जाती हैं; दायक 'देने वाले' वे हैं जो उन्हें देते हैं।"
        }
      },
      "c5": {
        "members": [
          "w4"
        ],
        "iast": "kapāla-mālikā-dharam",
        "type": "upapada",
        "structure": "((kapāla-mālikā)-dhara)",
        "vigraha": "कपालानां मालिका कपालमालिका, तां धरति इति, तम्",
        "meaning": {
          "en": "the wearer of a garland of skulls",
          "hi": "कपालों की माला धारण करने वाले"
        },
        "note": {
          "en": "kapāla-mālikā 'a garland of skulls' is what is worn; dhara 'wearing' comes from √dhṛ and only stands at the end of a compound.",
          "hi": "कपाल-मालिका 'कपालों की माला' वह है जो पहनी जाती है; धर 'धारण करने वाला' √धृ से बना है और समास के अन्त में ही आता है।"
        }
      },
      "c6": {
        "members": [
          "w5",
          "w6"
        ],
        "iast": "kāśikā-pura-adhinātha-kāla-bhairavam",
        "type": "karmadhāraya",
        "structure": "(((kāśikā-pura)-adhinātha)-(kāla-bhairava))",
        "vigraha": "काशिका इति पुरम्, तस्य अधिनाथः, स एव कालभैरवः, तम्",
        "meaning": {
          "en": "Kālabhairava, the supreme lord of the city of Kāśī",
          "hi": "काशी नगरी के अधिपति कालभैरव को"
        },
        "note": {
          "en": "kāśikā-pura 'the city Kāśikā'; with adhinātha 'supreme lord' it means the lord of that city; that title and the name Kāla-bhairava stand for one and the same person.",
          "hi": "काशिका-पुर 'काशी नगरी'; अधिनाथ 'अधिपति' के साथ अर्थ है उस नगरी के स्वामी; यह उपाधि और कालभैरव नाम एक ही के लिए हैं।"
        }
      }
    },
