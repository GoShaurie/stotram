  "translations": {
    "en": {
      "lines": [
        [
          {
            "refs": [
              "w1"
            ],
            "text": "The One whose hands grip trident and axe, noose and staff,"
          },
          {
            "refs": [
              "w1"
            ],
            "text": "the first cause,"
          }
        ],
        [
          {
            "refs": [
              "w2"
            ],
            "text": "dark of body, the first of the gods, the Imperishable,"
          },
          {
            "refs": [
              "w3"
            ],
            "text": "free from every ill,"
          }
        ],
        [
          {
            "refs": [
              "w4"
            ],
            "text": "of fearsome might,"
          },
          {
            "refs": [
              "w5"
            ],
            "text": "the Lord,"
          },
          {
            "refs": [
              "w6"
            ],
            "text": "who loves the wondrous Tāṇḍava dance:"
          }
        ],
        [
          {
            "refs": [
              "w9"
            ],
            "text": "I worship"
          },
          {
            "refs": [
              "w8"
            ],
            "text": "Kālabhairava,"
          },
          {
            "refs": [
              "w7"
            ],
            "text": "the supreme lord of the city of Kāśī."
          }
        ]
      ],
      "bhavartha": "In Kālabhairava's hands are a trident and an axe, a noose and a staff, and He is the first cause. His body is dark; He is the first of the gods, the Imperishable, free from every ill. His might is fearsome, He is the Lord, and He loves the wondrous Tāṇḍava dance. The singer worships Him: Kālabhairava, the supreme lord of the city of Kāśī."
    },
