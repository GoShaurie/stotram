    "translations": {
      "en": {
        "lines": [
          [
            {
              "refs": [
                "w1"
              ],
              "text": "The One who holds the trident, the hatchet, the noose and the rod in His hands,"
            },
            {
              "refs": [
                "w1"
              ],
              "text": "the first cause,"
            }
          ],
          [
