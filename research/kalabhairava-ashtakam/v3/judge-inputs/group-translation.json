              ],
              "text": "जो प्रभु हैं,"
            },
            {
              "refs": [
                "w6"
              ],
              "text": "जिन्हें विचित्र ताण्डव नृत्य प्रिय है,"
            }
          ],
          [
            {
              "refs": [
                "w7"
              ],
              "text": "काशी नगरी के अधिपति"
            },
            {
              "refs": [
                "w8"
              ],
              "text": "कालभैरव को"
            },
