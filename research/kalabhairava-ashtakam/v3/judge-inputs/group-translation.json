              ],
              "text": "who loves the wondrous tāṇḍava dance:"
            }
          ],
          [
            {
              "refs": [
                "w9"
              ],
              "text": "I worship"
            },
            {
              "refs": [
                "w8"
              ],
              "text": "Kālabhairava,"
            },
