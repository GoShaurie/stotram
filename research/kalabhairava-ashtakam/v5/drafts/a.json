  "translations": {
    "en": {
      "lines": [
        [
          {
            "refs": [
              "w1"
            ],
            "text": "The One who guards the dam of dharma"
          },
          {
            "refs": [
              "w2"
            ],
            "text": "and destroys the road of wrongdoing,"
          }
        ],
        [
          {
            "refs": [
              "w3"
            ],
            "text": "who loosens the bonds of karma,"
          },
          {
            "refs": [
              "w4"
            ],
            "text": "who gives true happiness,"
          },
          {
            "refs": [
              "w5"
            ],
            "text": "the Lord present everywhere,"
          }
        ],
        [
          {
            "refs": [
              "w6"
            ],
            "text": "whose whole body is adorned with the golden coils of the serpent Śeṣa:"
          }
        ],
        [
          {
            "refs": [
              "w9"
            ],
            "text": "I worship"
          },
          {
            "refs": [
              "w8"
            ],
            "text": "Kālabhairava,"
          },
          {
            "refs": [
              "w7"
            ],
            "text": "the supreme lord of the city of Kāśī."
          }
        ]
      ],
      "bhavartha": "Kālabhairava keeps standing the dam that holds dharma in place, and He destroys the road of wrongdoing. He loosens the bonds that our deeds tie around us, gives true happiness, and is the Lord present everywhere. The golden coils of the serpent Śeṣa adorn His whole body. The singer worships Him: Kālabhairava, the supreme lord of the city of Kāśī."
    },
    "hi": {
      "lines": [
        [
          {
            "refs": [
              "w1"
            ],
            "text": "जो धर्म के बाँध की रक्षा करते हैं"
          },
          {
            "refs": [
              "w2"
            ],
            "text": "और अधर्म के मार्ग का नाश करते हैं,"
          }
        ],
        [
          {
            "refs": [
              "w3"
            ],
            "text": "जो कर्म के बन्धनों से छुड़ाते हैं,"
