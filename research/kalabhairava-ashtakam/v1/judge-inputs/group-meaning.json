  "stotram": {
    "id": "kalabhairava-ashtakam",
    "title": {
      "sa": "कालभैरवाष्टकम्",
      "iast": "Kālabhairavāṣṭakam",
      "en": "Kalabhairava Ashtakam",
      "hi": "कालभैरवाष्टकम्"
    },
    "deities": [
      "kalabhairava",
      "shiva"
    ],
    "tradition": {
      "id": "shaiva"
    }
  },
  "verse": {
    "id": "v1",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "देवराजसेव्यमान",
            "iast": "devarājasevyamāna"
          },
          {
            "id": "w2",
            "text": "पावनाङ्घ्रिपङ्कजं",
            "iast": "pāvanāṅghripaṅkajaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w3",
            "text": "व्यालयज्ञसूत्रमिन्दुशेखरं",
            "iast": "vyālayajñasūtraminduśekharaṃ"
          },
          {
            "id": "w4",
            "text": "कृपाकरम्",
            "iast": "kṛpākaram"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w5",
            "text": "नारदादियोगिवृन्द",
            "iast": "nāradādiyogivṛnda"
          },
          {
            "id": "w6",
            "text": "वन्दितं",
            "iast": "vanditaṃ"
          },
          {
            "id": "w7",
            "text": "दिगम्बरं",
            "iast": "digambaraṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w8",
            "text": "काशिकापुराधिनाथ",
            "iast": "kāśikāpurādhinātha"
          },
          {
            "id": "w9",
            "text": "कालभैरवं",
            "iast": "kālabhairavaṃ"
          },
          {
            "id": "w10",
            "text": "भजे",
            "iast": "bhaje"
          }
        ],
        "end": "॥ १ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w1",
          "w2"
        ],
        "iast": "deva-rāja-sevyamāna-pāvana-aṅghri-paṅkajam",
        "type": "bahuvrīhi",
        "structure": "(((deva-rāja)-sevyamāna)-(pāvana-(aṅghri-paṅkaja)))",
        "vigraha": "देवराजेन सेव्यमाने पावने अङ्घ्रिपङ्कजे यस्य सः, तम्",
        "meaning": {
          "en": "Him whose holy lotus feet are served by the king of the gods",
          "hi": "उन्हें, जिनके पवित्र चरण-कमलों की सेवा देवराज करते हैं"
        },
        "note": {
          "en": "deva-rāja 'king of the gods' (Indra) is the one who serves (sevyamāna, 'being served'); aṅghri-paṅkaja 'foot-lotus' compares the feet to lotuses; pāvana 'holy, purifying' describes them. The whole describes Kālabhairava, the one who has such feet, and so takes his ending.",
          "hi": "देव-राज 'देवताओं के राजा' (इन्द्र) सेवा करने वाले हैं (सेव्यमान, 'जिसकी सेवा हो रही है'); अङ्घ्रि-पङ्कज 'चरण-कमल' चरणों की तुलना कमल से करता है; पावन 'पवित्र, पवित्र करने वाले' उनका विशेषण है। पूरा समास उन कालभैरव का वर्णन करता है जिनके ऐसे चरण हैं।"
        }
      },
      "c2": {
        "members": [
          "w3"
        ],
        "iast": "vyāla-yajña-sūtram",
        "type": "bahuvrīhi",
        "structure": "(vyāla-(yajña-sūtra))",
        "vigraha": "व्यालः यज्ञसूत्रं यस्य सः, तम्",
        "meaning": {
          "en": "Him whose sacred thread is a snake",
          "hi": "उन्हें, जिनका यज्ञोपवीत सर्प है"
        },
        "note": {
          "en": "yajña-sūtra 'sacred thread' (the thread worn for Vedic rites); with vyāla 'snake' it describes the one whose sacred thread is a snake. The first of two descriptions packed into the display word w3.",
          "hi": "यज्ञ-सूत्र 'यज्ञोपवीत'; व्याल 'सर्प' के साथ यह उनका वर्णन करता है जिनका यज्ञोपवीत सर्प है। w3 में जुड़े दो वर्णनों में पहला।"
        }
      },
      "c3": {
        "members": [
          "w3"
        ],
        "iast": "indu-śekharam",
        "type": "bahuvrīhi",
        "vigraha": "इन्दुः शेखरः यस्य सः, तम्",
        "meaning": {
          "en": "Him whose crest is the moon",
          "hi": "उन्हें, जिनका शिरोभूषण चन्द्रमा है"
        },
        "note": {
          "en": "indu 'moon' + śekhara 'crest': the one whose crest is the moon. Induśekhara is also a name of Śiva.",
          "hi": "इन्दु 'चन्द्रमा' + शेखर 'शिरोभूषण': जिनका शिरोभूषण चन्द्रमा है। इन्दुशेखर शिव का नाम भी है।"
        }
      },
      "c4": {
        "members": [
          "w4"
        ],
        "iast": "kṛpā-ākaram",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "कृपायाः आकरः, तम्",
        "meaning": {
          "en": "the mine of mercy",
          "hi": "कृपा की खान"
        },
        "note": {
          "en": "kṛpā 'mercy' + ākara 'mine, rich source'; the two long ā's merge into one.",
          "hi": "कृपा 'दया' + आकर 'खान'; दोनों दीर्घ आ मिलकर एक हो जाते हैं।"
        }
      },
      "c5": {
        "members": [
          "w5",
          "w6"
        ],
        "iast": "nārada-ādi-yogi-vṛnda-vanditam",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "structure": "((((nārada-ādi)-yogi)-vṛnda)-vandita)",
        "vigraha": "नारदः आदिः येषां ते नारदादयः, ते च ते योगिनः, तेषां वृन्दम्, तेन वन्दितः, तम्",
        "meaning": {
          "en": "praised by the crowds of yogis led by Nārada",
          "hi": "नारद आदि योगियों के समूह द्वारा वन्दित"
        },
        "note": {
          "en": "nārada-ādi 'Nārada and the rest' describes the yogis; yogi-vṛnda is their crowd; that crowd is the one who praises (vandita, 'praised').",
          "hi": "नारद-आदि 'नारद इत्यादि' योगियों का विशेषण है; योगि-वृन्द उनका समूह है; वही समूह वन्दना करता है (वन्दित, 'जिसकी वन्दना की गई')।"
        }
      },
      "c6": {
        "members": [
          "w7"
        ],
        "iast": "dig-ambaram",
        "type": "bahuvrīhi",
        "vigraha": "दिशः अम्बरं यस्य सः, तम्",
        "meaning": {
          "en": "Him whose clothing is the directions, the sky-clad",
          "hi": "उन्हें, जिनके वस्त्र दिशाएँ हैं, दिगम्बर"
        },
        "note": {
          "en": "diś 'direction' + ambara 'clothing; sky': the one whose only clothing is the directions of space.",
          "hi": "दिश् 'दिशा' + अम्बर 'वस्त्र; आकाश': जिनके वस्त्र केवल दिशाएँ हैं।"
        }
      },
      "c7": {
        "members": [
          "w8",
          "w9"
        ],
        "iast": "kāśikā-pura-adhinātha-kāla-bhairavam",
        "type": "karmadhāraya",
        "structure": "(((kāśikā-pura)-adhinātha)-(kāla-bhairava))",
        "vigraha": "काशिका इति पुरम्, तस्य अधिनाथः, स एव कालभैरवः, तम्",
        "meaning": {
          "en": "Kālabhairava, the supreme lord of the city of Kāśī",
          "hi": "काशी नगरी के अधिपति कालभैरव को"
        },
        "note": {
          "en": "kāśikā-pura 'the city Kāśikā'; with adhinātha 'supreme lord' it means the lord of that city; that title and the name Kāla-bhairava stand for one and the same person.",
          "hi": "काशिका-पुर 'काशी नगरी'; अधिनाथ 'अधिपति' के साथ अर्थ है उस नगरी के स्वामी; यह उपाधि और कालभैरव नाम एक ही के लिए हैं।"
        }
      }
    },
