      "vigraha": "कालभैरवस्य अष्टकम्",
      "meaning": {
        "en": "the eight verses on Kālabhairava",
        "hi": "कालभैरव के आठ श्लोक"
      },
      "note": {
        "en": "aṣṭaka, a set of eight, joined to the name Kālabhairava: 'the eight (verses) of Kālabhairava'. bhairava + aṣṭakam merge into bhairavāṣṭakam.",
        "hi": "अष्टक (आठ का समूह) कालभैरव नाम से जुड़ा है: 'कालभैरव का अष्टक'। भैरव + अष्टकम् मिलकर भैरवाष्टकम् बनते हैं।"
      }
    },
    "c2": {
      "members": ["w4"],
      "iast": "mano-haraṃ",
      "type": "upapada",
      "structure": "(mano-hara)",
      "vigraha": "मनः हरति इति",
      "meaning": {
        "en": "that which carries away the mind, charming",
        "hi": "जो मन को हर ले, मनोहर"
      },
      "note": {
        "en": "hara, 'taking away', from √hṛ, can only stand at the end of a compound here; manas 'mind' is what it takes: 'mind-stealing'.",
        "hi": "हर ('हरने वाला', √हृ से) यहाँ समास के अन्त में ही आता है; मनस् (मन) वह है जिसे वह हरता है: 'मन को हरने वाला'।"
      }
    },
    "c3": {
      "members": ["w5"],
      "iast": "jñāna-mukti-sādhanaṃ",
      "type": "tatpuruṣa",
      "subtype": "ṣaṣṭhī",
      "structure": "((jñāna-mukti)-sādhana)",
      "vigraha": "ज्ञानं च मुक्तिः च ज्ञानमुक्ती, तयोः साधनम्",
      "meaning": {
        "en": "the means to knowledge and liberation",
        "hi": "ज्ञान और मुक्ति का साधन"
      },
      "note": {
        "en": "jñāna and mukti are a pair (knowledge and liberation); sādhana, 'means', is the means to both.",
        "hi": "ज्ञान और मुक्ति एक जोड़ी हैं; साधन दोनों का साधन है।"
      }
    },
    "c4": {
      "members": ["w6"],
      "iast": "vicitra-puṇya-vardhanam",
      "type": "tatpuruṣa",
      "subtype": "ṣaṣṭhī",
      "structure": "((vicitra-puṇya)-vardhana)",
      "vigraha": "विचित्रं पुण्यं विचित्रपुण्यम्, तस्य वर्धनम्",
      "meaning": {
        "en": "that which increases merit of many kinds",
        "hi": "अनेक प्रकार के पुण्य को बढ़ाने वाला"
      },
      "note": {
        "en": "vicitra describes puṇya (merit); vardhana, 'increasing', takes the whole as what it increases.",
        "hi": "विचित्र पुण्य का विशेषण है; वर्धन ('बढ़ाने वाला') पूरे 'विचित्र पुण्य' को बढ़ाता है।"
      }
    },
    "c5": {
      "members": ["w7"],
      "iast": "śoka-moha-dainya-lobha-kopa-tāpa-nāśanaṃ",
      "type": "tatpuruṣa",
      "subtype": "ṣaṣṭhī",
      "structure": "((śoka-moha-dainya-lobha-kopa-tāpa)-nāśana)",
      "vigraha": "शोकः च मोहः च दैन्यं च लोभः च कोपः च तापः च, तेषां नाशनम्",
      "meaning": {
        "en": "that which destroys grief, delusion, misery, greed, anger and burning pain",
        "hi": "शोक, मोह, दीनता, लोभ, क्रोध और ताप का नाश करने वाला"
      },
      "note": {
        "en": "Six troubles listed side by side, then nāśana, 'destroying', which takes all six.",
        "hi": "छह कष्ट एक साथ गिनाए गए हैं, फिर नाशन ('नष्ट करने वाला') जो सभी छह पर लागू है।"
      }
