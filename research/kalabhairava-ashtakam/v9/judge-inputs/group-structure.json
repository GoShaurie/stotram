        "vigraha": "कालभैरवस्य अष्टकम्",
        "meaning": {
          "en": "the eight verses to Kālabhairava",
          "hi": "कालभैरव के आठ श्लोक"
        },
        "note": {
          "en": "aṣṭaka, a set of eight, joined to the name of the god it praises: the hymn names itself.",
          "hi": "अष्टक, आठ का समूह, जिस देवता की स्तुति है उसके नाम से जुड़ा है: स्तोत्र यहाँ अपना ही नाम लेता है।"
        }
      },
      "c2": {
        "members": [
          "w4"
        ],
        "iast": "mano-haraṃ",
        "type": "upapada",
        "vigraha": "मनः हरति इति",
        "meaning": {
          "en": "heart-stealing, charming",
          "hi": "मन को हरने वाला, मनोहर"
        },
        "note": {
          "en": "manas 'mind, heart' with hara 'taking away', from √hṛ: what steals the heart.",
          "hi": "मनस् 'मन' और √हृ से बना हर 'हरने वाला': जो मन को हर ले।"
        }
      },
      "c3": {
        "members": [
          "w5"
        ],
        "iast": "jñāna-mukti-sādhanaṃ",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((jñāna-mukti)-sādhana)",
        "vigraha": "ज्ञानं च मुक्तिः च ज्ञानमुक्ती, तयोः साधनम्",
        "meaning": {
          "en": "the means to knowledge and liberation",
          "hi": "ज्ञान और मुक्ति का साधन"
        },
        "note": {
          "en": "jñāna and mukti are paired ('knowledge and liberation'), and the pair is what sādhana, the means, leads to.",
          "hi": "ज्ञान और मुक्ति का जोड़ा बनता है, और साधन उसी जोड़े तक पहुँचाने वाला है।"
        }
      },
      "c4": {
        "members": [
          "w6"
        ],
        "iast": "vicitra-puṇya-vardhanam",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((vicitra-puṇya)-vardhana)",
        "vigraha": "विचित्रं पुण्यं विचित्रपुण्यम्, तस्य वर्धनम्",
        "meaning": {
          "en": "that which makes wonderful merit grow",
          "hi": "अद्भुत पुण्य को बढ़ाने वाला"
        },
        "note": {
          "en": "vicitra 'wonderful, many-sided' describes puṇya 'merit'; vardhana 'increasing' tells what is done to that merit.",
          "hi": "विचित्र 'अद्भुत, अनेक प्रकार का' पुण्य का विशेषण है; वर्धन 'बढ़ाने वाला' बताता है कि उस पुण्य का क्या होता है।"
        }
      },
      "c5": {
        "members": [
          "w7"
        ],
        "iast": "śoka-moha-dainya-lobha-kopa-tāpa-nāśanaṃ",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((śoka-moha-dainya-lobha-kopa-tāpa)-nāśana)",
        "vigraha": "शोकः च मोहः च दैन्यं च लोभः च कोपः च तापः च शोकमोहदैन्यलोभकोपतापाः, तेषां नाशनम्",
        "meaning": {
          "en": "that which destroys grief, delusion, misery, greed, anger and pain",
          "hi": "शोक, मोह, दीनता, लोभ, क्रोध और ताप का नाश करने वाला"
        },
        "note": {
          "en": "Six troubles are listed side by side as one group, and nāśana 'destroying' closes the list.",
          "hi": "छह कष्ट एक समूह के रूप में साथ-साथ गिनाए गए हैं, और अन्त में नाशन 'नाश करने वाला' आता है।"
        }
      },
      "c6": {
        "members": [
          "w10"
        ],
        "iast": "kālabhairava-aṅghri-sannidhiṃ",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((kālabhairava-aṅghri)-saṃnidhi)",
        "vigraha": "कालभैरवस्य अङ्घ्री कालभैरवाङ्घ्री, तयोः सन्निधिः, तम्",
        "meaning": {
          "en": "the presence of Kālabhairava's feet",
          "hi": "कालभैरव के चरणों की सन्निधि"
        },
        "note": {
          "en": "aṅghri 'foot' belongs to Kālabhairava, and saṃnidhi 'nearness, presence' is nearness to those feet.",
          "hi": "अङ्घ्रि 'चरण' कालभैरव के हैं, और सन्निधि 'निकटता' उन्हीं चरणों की निकटता है।"
        }
      }
    },
