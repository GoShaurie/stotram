  "verse": {
    "id": "v4",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "भुक्तिमुक्तिदायकं",
            "iast": "bhuktimuktidāyakaṃ"
          },
          {
            "id": "w2",
            "text": "प्रशस्तचारुविग्रहं",
            "iast": "praśastacāruvigrahaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w3",
            "text": "भक्तवत्सलं",
            "iast": "bhaktavatsalaṃ"
          },
          {
            "id": "w4",
            "text": "स्थितं",
            "iast": "sthitaṃ"
          },
          {
            "id": "w5",
            "text": "समस्तलोकविग्रहम्",
            "iast": "samastalokavigraham"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w6",
            "text": "निक्वणन्मनोज्ञहेमकिङ्किणीलसत्कटिं",
            "iast": "nikvaṇanmanojñahemakiṅkiṇīlasatkaṭiṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w7",
            "text": "काशिकापुराधिनाथ",
            "iast": "kāśikāpurādhinātha"
          },
          {
            "id": "w8",
            "text": "कालभैरवं",
            "iast": "kālabhairavaṃ"
          },
          {
            "id": "w9",
            "text": "भजे",
            "iast": "bhaje"
          }
        ],
        "end": "॥ ४ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w1"
        ],
        "iast": "bhukti-mukti-dāyakam",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((bhukti-mukti)-dāyaka)",
        "vigraha": "भुक्तिश्च मुक्तिश्च भुक्तिमुक्ती, तयोः दायकः, तम्",
        "meaning": {
          "en": "the giver of worldly enjoyment and liberation",
          "hi": "भुक्ति और मुक्ति देने वाले को"
        },
        "note": {
          "en": "bhukti 'enjoyment' and mukti 'liberation' are joined as a pair; dāyaka 'giver' says what He does with both.",
          "hi": "भुक्ति 'भोग' और मुक्ति 'मोक्ष' एक जोड़ी के रूप में जुड़े हैं; दायक 'देने वाला' बताता है कि वे दोनों को देते हैं।"
        }
      },
      "c2": {
        "members": [
          "w2"
        ],
        "iast": "praśasta-cāru-vigraham",
        "type": "bahuvrīhi",
        "structure": "((praśasta-cāru)-vigraha)",
        "vigraha": "प्रशस्तः चारुः च विग्रहः यस्य सः, तम्",
        "meaning": {
          "en": "Him whose form is praised and beautiful",
          "hi": "उन्हें, जिनका स्वरूप प्रशंसित और सुन्दर है"
        },
        "note": {
          "en": "praśasta 'praised' and cāru 'beautiful' both describe vigraha 'form'; the whole describes Kālabhairava, the one who has such a form.",
          "hi": "प्रशस्त 'प्रशंसित' और चारु 'सुन्दर' दोनों विग्रह 'स्वरूप' के विशेषण हैं; पूरा समास उन कालभैरव का वर्णन करता है जिनका ऐसा स्वरूप है।"
        }
      },
      "c3": {
        "members": [
          "w3"
        ],
        "iast": "bhakta-vatsalam",
        "type": "tatpuruṣa",
        "subtype": "saptamī",
        "vigraha": "भक्तेषु वत्सलः, तम्",
        "meaning": {
          "en": "loving to His devotees",
          "hi": "भक्तों पर स्नेह रखने वाले को"
        },
        "note": {
          "en": "vatsala 'loving, tender' with bhakta 'devotee' says whom the love is for.",
          "hi": "वत्सल 'स्नेही' के साथ भक्त 'उपासक' बताता है कि स्नेह किन पर है।"
        }
      },
      "c4": {
        "members": [
          "w5"
        ],
        "iast": "samasta-loka-vigraham",
        "type": "bahuvrīhi",
        "structure": "((samasta-loka)-vigraha)",
        "vigraha": "समस्तः लोकः विग्रहः यस्य सः, तम्",
        "meaning": {
          "en": "Him whose body is all the worlds",
          "hi": "उन्हें, सारे लोक ही जिनका शरीर हैं"
        },
        "note": {
          "en": "samasta-loka 'the whole world, all the worlds'; with vigraha 'body, form' it describes the one whose body is the whole world.",
          "hi": "समस्त-लोक 'सारा संसार, सभी लोक'; विग्रह 'शरीर, रूप' के साथ यह उनका वर्णन करता है जिनका शरीर सारा संसार है।"
        }
      },
      "c5": {
        "members": [
          "w6"
        ],
        "iast": "nikvaṇan-manojña-hema-kiṅkiṇī-lasat-kaṭim",
        "type": "bahuvrīhi",
        "structure": "((((nikvaṇat-manojña)-(hema-kiṅkiṇī))-lasat)-kaṭi)",
        "vigraha": "निक्वणन्त्यः मनोज्ञाः हेमकिङ्किण्यः, ताभिः लसन्ती कटिः यस्य सः, तम्",
        "meaning": {
          "en": "Him whose waist shines with lovely golden bells that jingle",
          "hi": "उन्हें, जिनकी कमर रुनझुन करते सोने के सुन्दर घुँघरुओं से शोभित है"
        },
        "note": {
          "en": "nikvaṇat 'jingling' and manojña 'lovely' describe hema-kiṅkiṇī 'golden bells'; lasat 'shining' says the waist (kaṭi) shines with them. The whole describes Kālabhairava, the one who has such a waist.",
          "hi": "निक्वणत् 'रुनझुन करते' और मनोज्ञ 'सुन्दर' हेम-किङ्किणी 'सोने के घुँघरू' के विशेषण हैं; लसत् 'चमकती' बताता है कि कमर (कटि) उनसे चमक रही है। पूरा समास उन कालभैरव का वर्णन करता है जिनकी ऐसी कमर है।"
        }
      },
      "c6": {
        "members": [
          "w7",
          "w8"
        ],
        "iast": "kāśikā-pura-adhinātha-kāla-bhairavam",
        "type": "karmadhāraya",
        "structure": "(((kāśikā-pura)-adhinātha)-(kāla-bhairava))",
        "vigraha": "काशिका इति पुरम्, तस्य अधिनाथः, स एव कालभैरवः, तम्",
        "meaning": {
          "en": "Kālabhairava, the supreme lord of the city of Kāśī",
          "hi": "काशी नगरी के अधिपति कालभैरव को"
        },
        "note": {
          "en": "kāśikā-pura 'the city Kāśikā'; with adhinātha 'supreme lord' it means the lord of that city; that title and the name Kāla-bhairava stand for one and the same person.",
          "hi": "काशिका-पुर 'काशी नगरी'; अधिनाथ 'अधिपति' के साथ अर्थ है उस नगरी के स्वामी; यह उपाधि और कालभैरव नाम एक ही के लिए हैं।"
        }
      }
    },
