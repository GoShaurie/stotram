      "end": ""
    },
    {
      "words": [
        {
          "id": "w6",
          "text": "काशिकापुराधिनाथ",
          "iast": "kāśikāpurādhinātha"
        },
        {
          "id": "w7",
          "text": "कालभैरवं",
          "iast": "kālabhairavaṃ"
        },
        {
          "id": "w8",
          "text": "भजे",
          "iast": "bhaje"
        }
      ],
      "end": "॥ ६ ॥"
    }
  ],
  "compounds": {
    "c1": {
      "members": [
