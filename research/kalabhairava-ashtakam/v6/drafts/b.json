      ],
      "iast": "ratna-pādukā-prabhā-abhirāma-pāda-yugmakam",
      "type": "bahuvrīhi",
      "structure": "((((ratna-pādukā)-prabhā)-abhirāma)-(pāda-yugmaka))",
      "vigraha": "रत्नपादुकानां प्रभया अभिरामं पादयुग्मकं यस्य सः, तम्",
      "meaning": {
        "en": "Him whose pair of feet is lovely in the glow of jewelled sandals",
        "hi": "उन्हें, जिनके चरण-युगल रत्नजड़ित पादुकाओं की चमक से सुन्दर हैं"
      },
      "note": {
        "en": "ratna-pādukā 'jewelled sandals'; their prabhā 'glow' makes the feet abhirāma 'lovely'; pāda-yugmaka is 'the pair of feet'. The whole describes Kālabhairava, the one who has such feet, and so takes His ending.",
        "hi": "रत्न-पादुका 'रत्नजड़ित खड़ाऊँ'; उनकी प्रभा 'चमक' चरणों को अभिराम 'सुन्दर' बनाती है; पाद-युग्मक 'चरणों का जोड़ा' है। पूरा समास उन कालभैरव का वर्णन करता है जिनके ऐसे चरण हैं।"
      }
    },
    "c2": {
      "members": [
        "w2"
      ],
      "iast": "a-dvitīyam",
      "type": "bahuvrīhi",
      "vigraha": "न विद्यते द्वितीयः यस्य सः, तम्",
      "meaning": {
        "en": "Him who has no second",
        "hi": "उन्हें, जिनके समान दूसरा कोई नहीं"
      },
      "note": {
        "en": "a- 'not' + dvitīya 'second': the one beside whom there is no second.",
        "hi": "अ- 'नहीं' + द्वितीय 'दूसरा': जिनके साथ कोई दूसरा नहीं।"
      }
    },
