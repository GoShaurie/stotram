          "id": "w1",
          "text": "रत्नपादुकाप्रभाभिरामपादयुग्मकं",
          "iast": "ratnapādukāprabhābhirāmapādayugmakaṃ"
        }
      ],
      "end": ""
    },
    {
      "words": [
        {
          "id": "w2",
          "text": "नित्यमद्वितीयमिष्टदैवतं",
          "iast": "nityamadvitīyamiṣṭadaivataṃ"
        },
        {
          "id": "w3",
          "text": "निरञ्जनम्",
          "iast": "nirañjanam"
        }
      ],
      "end": "।"
    },
    {
      "words": [
        {
          "id": "w4",
