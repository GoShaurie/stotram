  "stotram": {
    "id": "kalabhairava-ashtakam",
    "title": {
      "sa": "कालभैरवाष्टकम्",
      "iast": "Kālabhairavāṣṭakam",
      "en": "Kalabhairava Ashtakam",
      "hi": "कालभैरवाष्टकम्"
    }
  },
  "verse": {
    "id": "v8",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "भूतसङ्घनायकं",
            "iast": "bhūtasaṅghanāyakaṃ"
          },
          {
            "id": "w2",
            "text": "विशालकीर्तिदायकं",
            "iast": "viśālakīrtidāyakaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w3",
            "text": "काशिवासलोकपुण्यपापशोधकं",
            "iast": "kāśivāsalokapuṇyapāpaśodhakaṃ"
          },
          {
            "id": "w4",
            "text": "विभुम्",
            "iast": "vibhum"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w5",
            "text": "नीतिमार्गकोविदं",
            "iast": "nītimārgakovidaṃ"
          },
          {
            "id": "w6",
            "text": "पुरातनं",
            "iast": "purātanaṃ"
          },
          {
            "id": "w7",
            "text": "जगत्पतिं",
            "iast": "jagatpatiṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w8",
            "text": "काशिकापुराधिनाथ",
            "iast": "kāśikāpurādhinātha"
          },
          {
            "id": "w9",
            "text": "कालभैरवं",
            "iast": "kālabhairavaṃ"
          },
          {
            "id": "w10",
            "text": "भजे",
            "iast": "bhaje"
          }
        ],
        "end": "॥ ८ ॥"
      }
    ],
    "adhyahara": [],
    "anvaya": [
      "p1",
      "p2",
      "p3",
