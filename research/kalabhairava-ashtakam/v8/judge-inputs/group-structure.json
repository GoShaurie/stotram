    ],
    "compounds": {
      "c1": {
        "members": [
          "w1"
        ],
        "iast": "bhūta-saṅgha-nāyakam",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((bhūta-saṅgha)-nāyaka)",
        "vigraha": "भूतानां सङ्घाः भूतसङ्घाः, तेषां नायकः, तम्",
        "meaning": {
          "en": "the leader of the hosts of spirits (or of all beings)",
          "hi": "भूतगणों (या समस्त प्राणियों) के नायक को"
        },
        "note": {
          "en": "bhūta-saṅgha 'the hosts of bhūtas' is joined to nāyaka 'leader': the leader of those hosts. bhūta can mean a spirit or any living being.",
          "hi": "भूत-सङ्घ 'भूतों के समूह' नायक 'अगुआ' से जुड़ता है: उन समूहों के नायक। भूत का अर्थ प्रेत भी है और कोई भी प्राणी भी।"
        }
      },
      "c2": {
        "members": [
          "w2"
        ],
        "iast": "viśāla-kīrti-dāyakam",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((viśāla-kīrti)-dāyaka)",
        "vigraha": "विशाला कीर्तिः विशालकीर्तिः, तस्याः दायकः, तम्",
        "meaning": {
          "en": "the giver of great renown",
          "hi": "विशाल कीर्ति देने वाले को"
        },
        "note": {
          "en": "viśāla-kīrti 'great renown' (the adjective describes the noun) is what dāyaka 'the giver' gives.",
          "hi": "विशाल-कीर्ति 'बड़ी कीर्ति' (विशेषण और संज्ञा) वह है जिसे दायक 'देने वाला' देता है।"
        }
      },
      "c3": {
        "members": [
          "w3"
        ],
        "iast": "kāśi-vāsa-loka-puṇya-pāpa-śodhakam",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((((kāśi-vāsa)-loka)-(puṇya-pāpa))-śodhaka)",
        "vigraha": "काश्यां वासः काशिवासः, काशिवासस्य लोकाः काशिवासलोकाः, पुण्यं च पापं च पुण्यपापे, काशिवासलोकानां पुण्यपापयोः शोधकः, तम्",
        "meaning": {
          "en": "the one who purifies both the good deeds and the sins of the people living in Kāśī",
          "hi": "काशी में बसने वाले लोगों के पुण्य और पाप, दोनों को शुद्ध करने वाले को"
        },
        "note": {
          "en": "kāśi-vāsa 'living in Kāśī' describes loka 'the people'; puṇya-pāpa 'good deeds and sins' is a pair of equals. The people's deeds are what śodhaka 'the purifier' purifies.",
          "hi": "काशि-वास 'काशी में निवास' लोक 'लोगों' का परिचय देता है; पुण्य-पाप 'पुण्य और पाप' बराबर के दो शब्दों का जोड़ा है। उन लोगों के कर्म वह हैं जिन्हें शोधक 'शुद्ध करने वाला' शुद्ध करता है।"
        }
      },
      "c4": {
        "members": [
          "w5"
        ],
        "iast": "nīti-mārga-kovidam",
        "type": "tatpuruṣa",
        "subtype": "saptamī",
        "structure": "((nīti-mārga)-kovida)",
        "vigraha": "नीतेः मार्गः नीतिमार्गः, तस्मिन् कोविदः, तम्",
        "meaning": {
          "en": "skilled in the path of right conduct",
          "hi": "नीति के मार्ग के ज्ञाता को"
        },
        "note": {
          "en": "nīti-mārga 'the path of right conduct' is the field in which He is kovida 'skilled'.",
          "hi": "नीति-मार्ग 'नीति का मार्ग' वह क्षेत्र है जिसमें वे कोविद 'कुशल' हैं।"
        }
      },
      "c5": {
        "members": [
          "w7"
        ],
        "iast": "jagat-patim",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "जगतः पतिः, तम्",
        "meaning": {
          "en": "the lord of the world",
          "hi": "जगत के स्वामी को"
        },
        "note": {
          "en": "jagat 'the world' + pati 'lord': the lord of the world, a title also used of Śiva.",
          "hi": "जगत् 'संसार' + पति 'स्वामी': संसार के स्वामी; यह उपाधि शिव के लिए भी आती है।"
        }
      },
      "c6": {
        "members": [
          "w8",
          "w9"
        ],
        "iast": "kāśikā-pura-adhinātha-kāla-bhairavam",
        "type": "karmadhāraya",
        "structure": "(((kāśikā-pura)-adhinātha)-(kāla-bhairava))",
        "vigraha": "काशिका इति पुरम्, तस्य अधिनाथः, स एव कालभैरवः, तम्",
        "meaning": {
          "en": "Kālabhairava, the supreme lord of the city of Kāśī",
          "hi": "काशी नगरी के अधिपति कालभैरव को"
        },
        "note": {
          "en": "kāśikā-pura 'the city Kāśikā'; with adhinātha 'supreme lord' it means the lord of that city; that title and the name Kāla-bhairava stand for one and the same person.",
          "hi": "काशिका-पुर 'काशी नगरी'; अधिनाथ 'अधिपति' के साथ अर्थ है उस नगरी के स्वामी; यह उपाधि और कालभैरव नाम एक ही के लिए हैं।"
        }
      }
    },
