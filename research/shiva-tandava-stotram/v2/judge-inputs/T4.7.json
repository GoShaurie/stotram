  "stotram": {
    "id": "shiva-tandava-stotram",
    "title": {
      "sa": "शिवताण्डवस्तोत्रम्",
      "iast": "Śivatāṇḍavastotram",
      "en": "Shiva Tandava Stotram",
      "hi": "शिव ताण्डव स्तोत्र"
    }
  },
  "verse": {
    "id": "v2",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "जटाकटाह",
            "iast": "jaṭākaṭāha"
          },
          {
            "id": "w2",
            "text": "सम्भ्रमभ्रमन्",
            "iast": "sambhramabhraman"
          },
          {
            "id": "w3",
            "text": "निलिम्पनिर्झरी",
            "iast": "nilimpanirjharī"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w4",
            "text": "विलोलवीचिवल्लरी",
            "iast": "vilolavīcivallarī"
          },
          {
            "id": "w5",
            "text": "विराजमानमूर्द्धनि",
            "iast": "virājamānamūrddhani"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w6",
            "text": "धगद्धगद्धगज्",
            "iast": "dhagaddhagaddhagaj"
          },
          {
            "id": "w7",
            "text": "ज्वलल्",
            "iast": "jvalal"
          },
          {
            "id": "w8",
            "text": "ललाटपट्टपावके",
            "iast": "lalāṭapaṭṭapāvake"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w9",
            "text": "किशोरचन्द्रशेखरे",
            "iast": "kiśoracandraśekhare"
          },
          {
            "id": "w10",
            "text": "रतिः",
            "iast": "ratiḥ"
          },
          {
            "id": "w11",
            "text": "प्रतिक्षणं",
            "iast": "pratikṣaṇaṃ"
          },
          {
            "id": "w12",
            "text": "मम",
            "iast": "mama"
          }
        ],
        "end": "॥ २ ॥"
      }
    ],
    "translations": {
      "en": {
        "lines": [
          [
            {
              "refs": [
                "x1"
              ],
              "text": "May"
            },
            {
              "refs": [
                "w12"
              ],
              "text": "my"
            },
            {
              "refs": [
                "w10"
              ],
              "text": "love"
            },
            {
              "refs": [
                "x1"
              ],
              "text": "rest"
            },
            {
              "refs": [
                "w11"
              ],
              "text": "at every moment"
            },
            {
              "refs": [
                "x2"
              ],
              "text": "in Śiva,"
            }
          ],
          [
            {
              "refs": [
                "w5"
              ],
              "text": "whose head is resplendent"
            },
            {
              "refs": [
                "w4"
              ],
              "text": "with the restless, vine-like waves"
            },
            {
              "refs": [
                "w3"
              ],
              "text": "of the river of the gods"
            },
            {
              "refs": [
                "w2"
              ],
              "text": "as she whirls in a frenzy"
            },
            {
              "refs": [
                "w1"
              ],
              "text": "through the cauldron of His matted locks;"
            }
          ],
          [
            {
              "refs": [
                "w8"
              ],
              "text": "on the broad plate of whose forehead a fire"
            },
            {
              "refs": [
                "w7"
              ],
              "text": "blazes,"
            },
            {
              "refs": [
                "w6"
              ],
              "text": "crackling dhagad-dhagad-dhagad;"
            }
          ],
          [
            {
              "refs": [
                "w9"
              ],
              "text": "and who wears the young moon as His crest."
            }
          ]
        ],
        "bhavartha": "Caught in Śiva's coiled locks as if in a great bowl, the heavenly Gaṅgā spins round and round, and her trembling waves trail over His head like vines. On His forehead a fire snaps and blazes, and a young crescent moon crowns Him. The poet asks that his love for this Śiva, cool and fiery at once, never lapse, not even for a moment."
      },
      "hi": {
        "lines": [
          [
            {
              "refs": [
                "w1"
              ],
              "text": "जटा-रूपी कड़ाह में"
            },
            {
              "refs": [
                "w2"
              ],
              "text": "वेग से चक्कर काटती"
            },
            {
              "refs": [
                "w3"
              ],
              "text": "देवनदी (गंगा) की"
            },
            {
              "refs": [
                "w4"
              ],
              "text": "चंचल, लता-सी लहरों से"
            },
            {
              "refs": [
                "w5"
              ],
              "text": "जिनका मस्तक शोभित है,"
            }
          ],
          [
            {
              "refs": [
                "w8"
              ],
              "text": "जिनके ललाट-पटल पर आग"
            },
            {
              "refs": [
                "w6"
              ],
              "text": "धग्-धग्-धग् करती"
            },
            {
              "refs": [
                "w7"
              ],
              "text": "धधक रही है,"
            }
          ],
          [
            {
              "refs": [
                "w9"
              ],
              "text": "और जिनके शीश पर बाल-चन्द्रमा भूषण बनकर सजा है,"
            }
          ],
          [
            {
              "refs": [
                "x2"
              ],
              "text": "उन शिव में"
            },
            {
              "refs": [
                "w12"
              ],
              "text": "मेरी"
            },
            {
              "refs": [
                "w10"
              ],
              "text": "प्रीति"
            },
            {
              "refs": [
                "w11"
              ],
              "text": "हर क्षण"
            },
            {
              "refs": [
                "x1"
              ],
              "text": "बनी रहे।"
            }
          ]
        ],
        "bhavartha": "शिव की कुण्डलित जटाएँ मानो एक गहरा कड़ाह हैं, जिसमें देवनदी गंगा गोल-गोल घूम रही है और उसकी काँपती लहरें बेलों की तरह उनके सिर पर लहरा रही हैं। उनके माथे पर आग चटकती हुई धधक रही है, और सिर पर नया उगा चन्द्रमा सजा है। शीतल और प्रचण्ड, दोनों रूपों वाले ऐसे शिव के प्रति कवि चाहता है कि उसका प्रेम एक क्षण के लिए भी न छूटे।"
      }
    }
  }
}
