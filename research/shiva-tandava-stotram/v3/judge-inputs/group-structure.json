  "verse": {
    "id": "v3",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "धराधरेन्द्रनन्दिनी",
            "iast": "dharādharendranandinī"
          },
          {
            "id": "w2",
            "text": "विलासबन्धुबन्धुर",
            "iast": "vilāsabandhubandhura"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w3",
            "text": "स्फुरद्दिगन्तसन्तति",
            "iast": "sphuraddigantasantati"
          },
          {
            "id": "w4",
            "text": "प्रमोदमानमानसे",
            "iast": "pramodamānamānase"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w5",
            "text": "कृपाकटाक्षधोरणी",
            "iast": "kṛpākaṭākṣadhoraṇī"
          },
          {
            "id": "w6",
            "text": "निरुद्धदुर्धरापदि",
            "iast": "niruddhadurdharāpadi"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w7",
            "text": "क्वचिद्दिगम्बरे",
            "iast": "kvaciddigambare"
          },
          {
            "id": "w8",
            "text": "मनो",
            "iast": "mano"
          },
          {
            "id": "w9",
            "text": "विनोदमेतु",
            "iast": "vinodametu"
          },
          {
            "id": "w10",
            "text": "वस्तुनि",
            "iast": "vastuni"
          }
        ],
        "end": "॥ ३ ॥"
      }
    ],
