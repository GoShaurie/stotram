  "verse": {
    "id": "v8",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "नवीनमेघमण्डली",
            "iast": "navīnameghamaṇḍalī"
          },
          {
            "id": "w2",
            "text": "निरुद्धदुर्धरस्फुरत्",
            "iast": "niruddhadurdharasphurat"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w3",
            "text": "कुहूनिशीथिनीतमः",
            "iast": "kuhūniśīthinītamaḥ"
          },
          {
            "id": "w4",
            "text": "प्रबन्धबद्धकन्धरः",
            "iast": "prabandhabaddhakandharaḥ"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w5",
            "text": "निलिम्पनिर्झरीधरस्",
            "iast": "nilimpanirjharīdharas"
          },
          {
            "id": "w6",
            "text": "तनोतु",
            "iast": "tanotu"
          },
          {
            "id": "w7",
            "text": "कृत्तिसिन्धुरः",
            "iast": "kṛttisindhuraḥ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w8",
            "text": "कलानिधानबन्धुरः",
            "iast": "kalānidhānabandhuraḥ"
          },
          {
            "id": "w9",
            "text": "श्रियं",
            "iast": "śriyaṃ"
          },
          {
            "id": "w10",
            "text": "जगद्धुरन्धरः",
            "iast": "jagaddhurandharaḥ"
          }
        ],
        "end": "॥ ८ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w1",
          "w2",
          "w3",
          "w4"
        ],
        "iast": "navīna-megha-maṇḍalī-niruddha-durdhara-sphurat-kuhū-niśīthinī-tamaḥ-prabandha-baddha-kandharaḥ",
        "type": "bahuvrīhi",
        "structure": "((((((((navīna-megha)-maṇḍalī)-niruddha)-durdhara-sphurat)-((kuhū-niśīthinī)-tamas))-prabandha)-baddha)-kandhara)",
        "vigraha": "नवीनमेघमण्डल्या निरुद्धं दुर्धरं स्फुरत् च यत् कुहूनिशीथिन्याः तमः, तस्य प्रबन्धेन बद्धा कन्धरा यस्य सः",
        "meaning": {
          "en": "He whose neck is dark with a dense, unbroken mass of new-moon midnight darkness, darkness that is hard to bear, spreading, and hemmed in by banks of fresh clouds",
          "hi": "वे, जिनका कण्ठ नए मेघों की घटाओं से घिरे, असह्य और फैलते हुए अमावस की आधी रात के घने अन्धकार-सा काला है"
        },
        "note": {
          "en": "Twelve members across the pāda break, with a case ending only at the end (kandharaḥ, nominative). Inside: navīna-megha-maṇḍalī 'a ring of new clouds' is the instrument of niruddha 'hemmed in'; that, with durdhara 'hard to bear' and sphurat 'spreading', describes kuhū-niśīthinī-tamas 'the darkness of a new-moon night'; tamaḥ-prabandha is 'an unbroken mass of that darkness', and -baddha 'bound' says it is fixed on the neck (kandhara). The whole is a bahuvrīhi describing Śiva, the subject of tanotu.",
          "hi": "बारह पदों का समास, जो चरण की सीमा पार करता है; विभक्ति केवल अन्त में (कन्धरः, प्रथमा)। भीतर: नवीन-मेघ-मण्डली 'नए बादलों का घेरा' निरुद्ध 'घिरा हुआ' का करण है; यह, दुर्धर 'असह्य' और स्फुरत् 'फैलता हुआ' के साथ, कुहू-निशीथिनी-तमस् 'अमावस की रात का अन्धकार' का विशेषण है; तमः-प्रबन्ध 'उस अन्धकार का अटूट पुंज' है, और -बद्ध 'बँधा' बताता है कि वह कण्ठ (कन्धर) पर टिका है। पूरा समास बहुव्रीहि है, जो तनोतु के कर्ता शिव का वर्णन करता है।"
        }
      },
      "c2": {
        "members": [
          "w5"
        ],
        "iast": "nilimpa-nirjharī-dharaḥ",
        "type": "upapada",
        "structure": "((nilimpa-nirjharī)-dhara)",
        "vigraha": "निलिम्पनिर्झरीं धरति इति",
        "meaning": {
          "en": "the bearer of the river of the gods",
          "hi": "देवनदी (गंगा) को धारण करने वाले"
        },
        "note": {
          "en": "nilimpa-nirjharī 'the river of the gods' (a name of the Gaṅgā, met in verse 2) is the object of dhara 'bearing', an agent noun from √dhṛ that only stands at the end of a compound. The result means the same as the familiar name Gaṅgādhara.",
          "hi": "निलिम्प-निर्झरी 'देवताओं की नदी' (गंगा का नाम, जो दूसरे श्लोक में भी आया) धर 'धारण करने वाला' का कर्म है; धर √धृ से बना कर्तृवाचक शब्द है, जो समास के अन्त में आता है। अर्थ वही है जो प्रसिद्ध नाम गंगाधर का।"
        }
      },
      "c3": {
        "members": [
          "w7"
        ],
        "iast": "kṛtti-sindhuraḥ",
        "type": "bahuvrīhi",
        "vigraha": "सिन्धुरस्य कृत्तिः यस्य सः",
        "meaning": {
          "en": "He whose garment is an elephant's hide",
          "hi": "वे, जिनका वस्त्र हाथी की खाल है"
        },
        "note": {
          "en": "kṛtti 'hide' and sindhura 'elephant' stand in an unusual order: the sense is sindhurasya kṛttiḥ, 'the elephant's hide', and the compound describes the one who has it. Placing the possessed thing first suits the metre and the rhyme on -dhuraḥ.",
          "hi": "कृत्ति 'खाल' और सिन्धुर 'हाथी' असामान्य क्रम में हैं: अर्थ है सिन्धुरस्य कृत्तिः, 'हाथी की खाल', और समास उसका वर्णन करता है जिसके पास वह है। यह क्रम छन्द और -धुरः की तुक के अनुकूल है।"
        }
      },
      "c4": {
        "members": [
          "w8"
        ],
        "iast": "kalā-nidhāna-bandhuraḥ",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "structure": "((kalā-nidhāna)-bandhura)",
        "vigraha": "कलानां निधानं कलानिधानम्, तेन बन्धुरः",
        "meaning": {
          "en": "lovely with the moon, the store of digits",
          "hi": "चन्द्रमा (कलाओं के भण्डार) से मनोहर"
        },
        "note": {
          "en": "kalā-nidhāna 'the store of digits' is a ṣaṣṭhī tatpuruṣa naming the moon, like the dictionary's kalā-nidhi. It then stands in the instrumental relation to bandhura 'lovely, adorned': lovely by means of the moon.",
          "hi": "कला-निधान 'कलाओं का भण्डार' षष्ठी तत्पुरुष है और चन्द्रमा का नाम है, जैसे कोश का कला-निधि। फिर यह बन्धुर 'मनोहर, अलंकृत' से तृतीया सम्बन्ध में जुड़ता है: चन्द्रमा से सुशोभित।"
        }
      },
      "c5": {
        "members": [
          "w10"
        ],
        "iast": "jagad-dhurandharaḥ",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "(jagat-(dhuram-dhara))",
        "vigraha": "जगतः धुरन्धरः",
        "meaning": {
          "en": "the bearer of the world's yoke",
          "hi": "जगत का भार उठाने वाले"
        },
        "note": {
          "en": "dhuraṃ-dhara 'yoke-bearer' is itself a compound in which the first member keeps its accusative ending (dhuram); jagat 'the world' is joined to it in the genitive sense: the one who bears the burden of the world.",
          "hi": "धुरं-धर 'धुरा उठाने वाला' स्वयं एक समास है जिसमें पहला पद अपनी द्वितीया विभक्ति (धुरम्) बनाए रखता है; जगत् षष्ठी अर्थ में इससे जुड़ता है: जो जगत का भार उठाते हैं।"
        }
      }
    },
