  "verse": {
    "id": "v17",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "पूजावसानसमये",
            "iast": "pūjāvasānasamaye"
          },
          {
            "id": "w2",
            "text": "दशवक्त्रगीतं",
            "iast": "daśavaktragītaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w3",
            "text": "यः",
            "iast": "yaḥ"
          },
          {
            "id": "w4",
            "text": "शम्भुपूजनपरं",
            "iast": "śambhupūjanaparaṃ"
          },
          {
            "id": "w5",
            "text": "पठति",
            "iast": "paṭhati"
          },
          {
            "id": "w6",
            "text": "प्रदोषे",
            "iast": "pradoṣe"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w7",
            "text": "तस्य",
            "iast": "tasya"
          },
          {
            "id": "w8",
            "text": "स्थिरां",
            "iast": "sthirāṃ"
          },
          {
            "id": "w9",
            "text": "रथगजेन्द्रतुरङ्गयुक्तां",
            "iast": "rathagajendraturaṅgayuktāṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w10",
            "text": "लक्ष्मीं",
            "iast": "lakṣmīṃ"
          },
          {
            "id": "w11",
            "text": "सदैव",
            "iast": "sadaiva"
          },
          {
            "id": "w12",
            "text": "सुमुखीं",
            "iast": "sumukhīṃ"
          },
          {
            "id": "w13",
            "text": "प्रददाति",
            "iast": "pradadāti"
          },
          {
            "id": "w14",
            "text": "शम्भुः",
            "iast": "śambhuḥ"
          }
        ],
        "end": "॥ १७ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w1"
        ],
        "iast": "pūjā-avasāna-samaye",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((pūjā-avasāna)-samaya)",
        "vigraha": "पूजायाः अवसानम्, तस्य समयः, तस्मिन्",
        "meaning": {
          "en": "at the time when worship ends",
          "hi": "पूजा के समापन के समय"
        },
        "note": {
          "en": "pūjā 'worship' + avasāna 'end' makes 'the end of worship'; with samaya 'time' it becomes 'the time of the end of worship'. The -e ending means 'at'.",
          "hi": "पूजा + अवसान से 'पूजा का अन्त' बनता है; समय के साथ 'पूजा के अन्त का समय'। '-ए' अन्त का अर्थ है 'में, पर'।"
        }
      },
      "c2": {
        "members": [
          "w2"
        ],
        "iast": "daśa-vaktra-gītaṃ",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "structure": "((daśa-vaktra)-gīta)",
        "vigraha": "दश वक्त्राणि यस्य सः दशवक्त्रः, तेन गीतम्",
        "meaning": {
          "en": "sung by the Ten-faced One, i.e. Rāvaṇa",
          "hi": "दशमुख, अर्थात् रावण, द्वारा गाया हुआ"
        },
        "note": {
          "en": "daśa-vaktra 'having ten faces' is itself a description that names Rāvaṇa; gīta 'sung' tells what he did with the hymn.",
          "hi": "दश-वक्त्र 'दस मुखों वाला' स्वयं रावण का वर्णनात्मक नाम है; गीत 'गाया हुआ' बताता है कि उसने इस स्तोत्र का क्या किया।"
        }
      },
      "c3": {
        "members": [
          "w4"
        ],
        "iast": "śambhu-pūjana-paraṃ",
        "type": "bahuvrīhi",
        "structure": "((śambhu-pūjana)-para)",
        "vigraha": "शम्भोः पूजनं परं (प्रधानं) यस्य तत्",
        "meaning": {
          "en": "(this hymn) wholly given to the worship of Śambhu",
          "hi": "(यह स्तोत्र) जो पूरी तरह शम्भु की पूजा को समर्पित है"
        },
        "note": {
          "en": "śambhu-pūjana 'the worship of Śambhu'; with para 'chief aim' at the end, the whole describes something whose chief aim is that worship. Its ending ties it to the hymn being recited.",
          "hi": "शम्भु-पूजन 'शम्भु की पूजा'; अन्त में पर 'मुख्य लक्ष्य' जुड़ने से पूरा शब्द उस चीज़ का वर्णन करता है जिसका मुख्य लक्ष्य यही पूजा है। इसका अन्त इसे पढ़े जाने वाले स्तोत्र से जोड़ता है।"
        }
      },
      "c4": {
        "members": [
          "w9"
        ],
        "iast": "ratha-gaja-indra-turaṅga-yuktāṃ",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "structure": "((ratha-(gaja-indra)-turaṅga)-yukta)",
        "vigraha": "रथाः च गजेन्द्राः च तुरङ्गाः च रथगजेन्द्रतुरङ्गाः, तैः युक्ता, ताम्",
        "meaning": {
          "en": "(fortune) rich in chariots, great elephants and horses",
          "hi": "रथों, श्रेष्ठ हाथियों और घोड़ों से युक्त (लक्ष्मी)"
        },
        "note": {
          "en": "Three things listed side by side, chariots, kings of elephants (gaja-indra) and horses, then yukta 'furnished with' them. The whole describes Lakṣmī.",
          "hi": "तीन चीज़ें साथ-साथ गिनाई गई हैं, रथ, हाथियों के राजा (गज-इन्द्र) और घोड़े, फिर युक्त 'इनसे भरी हुई'। पूरा शब्द लक्ष्मी का वर्णन है।"
        }
      },
      "c5": {
        "members": [
          "w12"
        ],
        "iast": "su-mukhīṃ",
        "type": "bahuvrīhi",
        "structure": "(su-mukha)",
        "vigraha": "शोभनं मुखं यस्याः सा, ताम्",
        "meaning": {
          "en": "(Lakṣmī) with a kind, smiling face",
          "hi": "प्रसन्न मुख वाली (लक्ष्मी)"
        },
        "note": {
          "en": "su 'good' + mukha 'face': 'she whose face is good', that is fair-faced and gracious. It describes Lakṣmī.",
          "hi": "सु 'अच्छा' + मुख: 'जिसका मुख अच्छा है', अर्थात् सुन्दर और कृपालु मुख वाली। यह लक्ष्मी का वर्णन है।"
        }
      }
    },
