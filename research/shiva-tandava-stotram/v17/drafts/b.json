  "compounds": {
    "c1": {
      "members": ["w1"],
      "iast": "pūjā-avasāna-samaye",
      "type": "tatpuruṣa",
      "subtype": "ṣaṣṭhī",
      "structure": "((pūjā-avasāna)-samaya)",
      "vigraha": "पूजायाः अवसानम्, तस्य समयः, तस्मिन्",
      "meaning": {
        "en": "at the time when worship comes to its close",
        "hi": "पूजा के समापन के समय"
      },
      "note": {
        "en": "pūjā 'worship' + avasāna 'close' gives 'the close of worship'; with samaya 'time' it becomes 'the time of the close of worship'. The -e ending means 'at' that time.",
        "hi": "पूजा + अवसान = 'पूजा का समापन'; समय जुड़कर 'पूजा के समापन का समय' बनता है। अन्त का -ए बताता है 'उस समय पर'।"
      }
    },
    "c2": {
      "members": ["w2"],
      "iast": "daśa-vaktra-gītaṃ",
      "type": "tatpuruṣa",
      "subtype": "tṛtīyā",
      "structure": "((daśa-vaktra)-gīta)",
      "vigraha": "दश वक्त्राणि यस्य सः दशवक्त्रः, तेन गीतम्",
      "meaning": {
        "en": "sung by the ten-faced one, i.e. Rāvaṇa",
        "hi": "दस मुखों वाले, अर्थात् रावण के द्वारा गाया गया"
      },
      "note": {
        "en": "daśa-vaktra 'having ten faces' is a name-picture of Rāvaṇa; gīta 'sung' says what he did. Together: '(the hymn) sung by the ten-faced one'.",
        "hi": "दश-वक्त्र 'दस मुखों वाला' रावण का चित्र-नाम है; गीत 'गाया गया' बताता है कि उसने क्या किया। मिलकर: 'दस मुखों वाले द्वारा गाया गया (स्तोत्र)'।"
      }
    },
    "c3": {
      "members": ["w4"],
      "iast": "śambhu-pūjana-paraṃ",
      "type": "bahuvrīhi",
      "structure": "((śambhu-pūjana)-para)",
      "vigraha": "शम्भोः पूजनम् परम् (प्रधानम्) यस्य तत्",
      "meaning": {
        "en": "(the hymn) whose whole aim is the worship of Śambhu, i.e. Śiva",
        "hi": "(वह स्तोत्र) जिसका मुख्य उद्देश्य शम्भु, अर्थात् शिव की पूजा है"
      },
      "note": {
        "en": "śambhu-pūjana 'the worship of Śambhu'; para at the end of a compound means 'having this as its chief aim'. The whole describes the hymn, so it takes the hymn's -am ending.",
        "hi": "शम्भु-पूजन 'शम्भु की पूजा'; समास के अन्त में पर का अर्थ है 'जिसका यही मुख्य लक्ष्य हो'। पूरा समास स्तोत्र का वर्णन करता है, इसलिए स्तोत्र जैसा -म् अन्त लेता है।"
      }
    },
    "c4": {
      "members": ["w9"],
      "iast": "ratha-gaja-indra-turaṅga-yuktāṃ",
      "type": "tatpuruṣa",
      "subtype": "tṛtīyā",
      "structure": "((ratha-(gaja-indra)-turaṅga)-yukta)",
      "vigraha": "गजानाम् इन्द्राः गजेन्द्राः; रथाः च गजेन्द्राः च तुरङ्गाः च, तैः युक्ता, ताम्",
      "meaning": {
        "en": "(Lakṣmī) furnished with chariots, lordly elephants and horses",
        "hi": "रथों, श्रेष्ठ हाथियों और घोड़ों से युक्त (लक्ष्मी)"
      },
      "note": {
        "en": "gaja-indra 'lord of elephants', a fine elephant; ratha, gajendra and turaṅga form a list 'chariots, great elephants and horses'; yukta 'furnished with' closes it. The -ām ending ties it to lakṣmīm.",
        "hi": "गज-इन्द्र 'हाथियों का राजा', श्रेष्ठ हाथी; रथ, गजेन्द्र और तुरङ्ग की सूची 'रथ, श्रेष्ठ हाथी और घोड़े' बनती है; युक्त 'से सम्पन्न' उसे पूरा करता है। -आम् अन्त इसे लक्ष्मीम् से जोड़ता है।"
      }
    },
    "c5": {
      "members": ["w12"],
      "iast": "su-mukhīṃ",
      "type": "bahuvrīhi",
      "vigraha": "शोभनं मुखं यस्याः सा, ताम्",
      "meaning": {
        "en": "(Lakṣmī) of the bright, kind face",
        "hi": "सुन्दर, प्रसन्न मुख वाली (लक्ष्मी)"
      },
      "note": {
        "en": "su 'good, fair' + mukha 'face': 'she whose face is bright', so cheerful and gracious.",
        "hi": "सु 'सुन्दर, शुभ' + मुख: 'जिसका मुख सुन्दर हो', अर्थात् प्रसन्न और कृपालु।"
      }
    }
  },
