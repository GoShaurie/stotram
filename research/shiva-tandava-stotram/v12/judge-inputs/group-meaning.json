  "stotram": {
    "id": "shiva-tandava-stotram",
    "title": {
      "sa": "शिवताण्डवस्तोत्रम्",
      "iast": "Śivatāṇḍavastotram",
      "en": "Shiva Tandava Stotram",
      "hi": "शिव ताण्डव स्तोत्र"
    },
    "deities": [
      "shiva"
    ],
    "tradition": {
      "id": "shaiva"
    }
  },
  "verse": {
    "id": "v12",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "दृषद्विचित्रतल्पयोर्",
            "iast": "dṛṣadvicitratalpayor"
          },
          {
            "id": "w2",
            "text": "भुजङ्गमौक्तिकस्रजो",
            "iast": "bhujaṅgamauktikasrajo"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w3",
            "text": "र्गरिष्ठरत्नलोष्ठयोः",
            "iast": "rgariṣṭharatnaloṣṭhayoḥ"
          },
          {
            "id": "w4",
            "text": "सुहृद्विपक्षपक्षयोः",
            "iast": "suhṛdvipakṣapakṣayoḥ"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w5",
            "text": "तृणारविन्दचक्षुषोः",
            "iast": "tṛṇāravindacakṣuṣoḥ"
          },
          {
            "id": "w6",
            "text": "प्रजामहीमहेन्द्रयोः",
            "iast": "prajāmahīmahendrayoḥ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w7",
            "text": "समप्रवृत्तिकः",
            "iast": "samapravṛttikaḥ"
          },
          {
            "id": "w8",
            "text": "कदा",
            "iast": "kadā"
          },
          {
            "id": "w9",
            "text": "सदाशिवं",
            "iast": "sadāśivaṃ"
          },
          {
            "id": "w10",
            "text": "भजाम्यहम्",
            "iast": "bhajāmyaham"
          }
        ],
        "end": "॥ १२ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w1"
        ],
        "iast": "dṛṣad-vicitra-talpayor",
        "type": "dvandva",
        "subtype": "itaretara",
        "structure": "(dṛṣad-(vicitra-talpa))",
        "vigraha": "दृषत् च विचित्रतल्पः च, तयोः",
        "meaning": {
          "en": "towards a stone and a richly coloured couch",
          "hi": "पत्थर और रंग-बिरंगी शय्या (दोनों) में"
        },
        "note": {
          "en": "An itaretara dvandva of two members, so it stands in the dual: dṛṣad 'stone' and vicitra-talpa 'a many-coloured couch' (itself a karmadhāraya, the adjective vicitra qualifying talpa). The locative dual -yoḥ marks the pair as the things towards which one's conduct is to be the same.",
          "hi": "दो पदों का इतरेतर द्वन्द्व, इसलिए द्विवचन: दृषद् 'पत्थर' और विचित्र-तल्प 'रंग-बिरंगी शय्या' (जो स्वयं कर्मधारय है, विचित्र विशेषण और तल्प विशेष्य)। सप्तमी द्विवचन '-योः' बताता है कि इन दोनों के प्रति आचरण समान होना है।"
        }
      },
      "c2": {
        "members": [
          "w2"
        ],
        "iast": "bhujaṅga-mauktika-srajo",
        "type": "dvandva",
        "subtype": "itaretara",
        "structure": "(bhujaṅga-(mauktika-sraj))",
        "vigraha": "भुजङ्गः च मौक्तिकस्रक् च, तयोः",
        "meaning": {
          "en": "towards a snake and a string of pearls",
          "hi": "साँप और मोतियों की माला (दोनों) में"
        },
        "note": {
          "en": "A dvandva of bhujaṅga 'snake' and mauktika-sraj 'pearl garland' (a ṣaṣṭhī tatpuruṣa: mauktikānāṃ srak, 'a garland of pearls'). The ending is the locative dual srajoḥ; its visarga becomes r before the g of the next word, and that r is printed at the start of line 2.",
          "hi": "भुजङ्ग 'साँप' और मौक्तिक-स्रज् 'मोतियों की माला' (षष्ठी तत्पुरुष: मौक्तिकानां स्रक्) का द्वन्द्व। अन्त में सप्तमी द्विवचन स्रजोः है; अगले शब्द के 'ग' से पहले इसका विसर्ग 'र्' बनता है, और वह 'र्' दूसरी पंक्ति के आरम्भ में छपा है।"
        }
      },
      "c3": {
        "members": [
          "w3"
        ],
        "iast": "gariṣṭha-ratna-loṣṭhayoḥ",
        "type": "dvandva",
        "subtype": "itaretara",
        "structure": "((gariṣṭha-ratna)-loṣṭha)",
        "vigraha": "गरिष्ठरत्नं च लोष्ठः च, तयोः",
        "meaning": {
          "en": "towards a priceless gem and a clod of earth",
          "hi": "बहुमूल्य रत्न और मिट्टी के ढेले (दोनों) में"
        },
        "note": {
          "en": "gariṣṭha-ratna 'a most precious gem' is a karmadhāraya; joined with loṣṭha 'clod' it forms a dvandva in the locative dual. The display word begins with the r carried over from srajoḥ (w2); it is not part of gariṣṭha.",
          "hi": "गरिष्ठ-रत्न 'अत्यन्त मूल्यवान रत्न' कर्मधारय है; लोष्ठ 'ढेला' के साथ यह सप्तमी द्विवचन में द्वन्द्व बनाता है। प्रदर्शित शब्द के आरम्भ का 'र्' स्रजोः (w2) से आया है; वह गरिष्ठ का भाग नहीं।"
        }
      },
      "c4": {
        "members": [
          "w4"
        ],
        "iast": "suhṛd-vipakṣa-pakṣayoḥ",
        "type": "dvandva",
        "subtype": "itaretara",
        "structure": "(suhṛd-(vipakṣa-pakṣa))",
        "vigraha": "सुहृत् च विपक्षपक्षः च, तयोः",
        "meaning": {
          "en": "towards a friend and the enemy's camp",
          "hi": "मित्र और शत्रु-पक्ष (दोनों) में"
        },
        "note": {
          "en": "suhṛd 'friend' paired with vipakṣa-pakṣa 'the side of the adversary' (ṣaṣṭhī tatpuruṣa: vipakṣasya pakṣaḥ), following the vyakhya.org split. Another way to read it is (suhṛd-vipakṣa)-pakṣa, 'the two sides, of friend and of foe'; the sense is the same.",
          "hi": "सुहृद् 'मित्र' और विपक्ष-पक्ष 'शत्रु का पक्ष' (षष्ठी तत्पुरुष: विपक्षस्य पक्षः) का द्वन्द्व, vyakhya.org के विभाजन के अनुसार। इसे (सुहृद्-विपक्ष)-पक्ष, 'मित्र और शत्रु, दोनों के पक्ष', भी पढ़ा जा सकता है; अर्थ वही रहता है।"
        }
      },
      "c5": {
        "members": [
          "w5"
        ],
        "iast": "tṛṇa-aravinda-cakṣuṣoḥ",
        "type": "dvandva",
        "subtype": "itaretara",
        "structure": "(tṛṇa-(aravinda-cakṣus))",
        "vigraha": "तृणं च अरविन्दचक्षुः च, तयोः",
        "meaning": {
          "en": "towards a blade of grass and one with lotus eyes",
          "hi": "तिनके और कमल-से नेत्रों वाले (दोनों) में"
        },
        "note": {
          "en": "tṛṇa 'grass' paired with aravinda-cakṣus 'one whose eyes are lotuses', a bahuvrīhi (aravinde iva cakṣuṣī yasya) used as a noun, as the vyakhya.org gloss takes it. shlokam.org and the Samskrit Academy page instead read 'grass and lotus' together with 'eyes'.",
          "hi": "तृण 'तिनका' और अरविन्द-चक्षुस् 'जिसके नेत्र कमल जैसे हों' (बहुव्रीहि: अरविन्दे इव चक्षुषी यस्य), जो यहाँ संज्ञा की तरह आया है, जैसा vyakhya.org मानता है। shlokam.org और संस्कृत अकादमी का पृष्ठ 'तिनका और कमल' को 'नेत्रों' के साथ जोड़कर पढ़ते हैं।"
        }
      },
      "c6": {
        "members": [
          "w6"
        ],
        "iast": "prajā-mahī-mahendrayoḥ",
        "type": "dvandva",
        "subtype": "itaretara",
        "structure": "(prajā-(mahī-mahendra))",
        "vigraha": "प्रजा च महीमहेन्द्रः च, तयोः",
        "meaning": {
          "en": "towards a common subject and the sovereign of the earth",
          "hi": "साधारण प्रजा और पृथ्वी के सम्राट (दोनों) में"
        },
        "note": {
          "en": "prajā 'a subject' paired with mahī-mahendra, literally 'the great Indra of the earth' (ṣaṣṭhī tatpuruṣa: mahyāḥ mahendraḥ), i.e. an emperor. shlokam.org divides it prajāmahī + mahendra; the vyakhya.org split prajā + mahīmahendra gives the cleaner pair.",
          "hi": "प्रजा 'साधारण जन' और मही-महेन्द्र, शाब्दिक 'पृथ्वी का महान इन्द्र' (षष्ठी तत्पुरुष: मह्याः महेन्द्रः), अर्थात् सम्राट। shlokam.org इसे प्रजामही + महेन्द्र बाँटता है; vyakhya.org का विभाजन प्रजा + महीमहेन्द्र जोड़ी को अधिक स्पष्ट बनाता है।"
        }
      },
      "c7": {
        "members": [
          "w7"
        ],
        "iast": "sama-pravṛttikaḥ",
        "type": "bahuvrīhi",
        "vigraha": "समा प्रवृत्तिः यस्य सः",
        "meaning": {
          "en": "one whose conduct is the same (towards all)",
          "hi": "जिसका आचरण (सबके प्रति) समान हो"
        },
        "note": {
          "en": "sama 'same, impartial' + pravṛtti 'conduct', closed by the suffix -ka that is often added at the end of a bahuvrīhi. It qualifies the speaker, aham.",
          "hi": "सम 'समान, निष्पक्ष' + प्रवृत्ति 'आचरण', अन्त में '-क' प्रत्यय, जो प्रायः बहुव्रीहि के अन्त में जुड़ता है। यह वक्ता 'अहम्' का विशेषण है।"
        }
      }
    },
