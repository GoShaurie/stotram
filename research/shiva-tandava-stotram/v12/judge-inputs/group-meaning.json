          },
          {
            "sa": "विचित्र",
            "iast": "vicitra"
          },
          {
            "sa": "तल्पयोः",
            "iast": "talpayoḥ"
          }
        ],
        "sandhi": [
          {
            "name": "jaśtva",
            "rule": "t + v → d + v",
            "explanation": {
              "en": "The final t of dṛṣat becomes the voiced d before the v of vicitra: dṛṣat + vicitra → dṛṣadvicitra.",
              "hi": "दृषत् का अन्तिम 'त्' आगे के घोष 'व' (विचित्र) के कारण 'द्' बन जाता है: दृषत् + विचित्र → दृषद्विचित्र।"
            }
          },
          {
            "name": "visarga",
            "rule": "-oḥ + voiced consonant → -or",
            "explanation": {
              "en": "The visarga of talpayoḥ becomes r before the voiced bh of bhujaṅga (next display word): talpayoḥ + bhujaṅga → talpayor bhujaṅga.",
              "hi": "तल्पयोः का विसर्ग आगे के घोष 'भ' (भुजङ्ग) के कारण 'र्' बन जाता है: तल्पयोः + भुजङ्ग → तल्पयोर्भुजङ्ग।"
            }
          }
        ],
