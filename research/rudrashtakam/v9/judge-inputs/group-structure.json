        "sandhi": [
          {
            "name": "savarṇa-dīrgha",
            "rule": "a + a → ā",
            "explanation": {
              "en": "The final a of rudra and the first a of aṣṭaka merge into one long ā: rudra + aṣṭaka → rudrāṣṭaka.",
              "hi": "रुद्र का अन्तिम 'अ' और अष्टक का पहला 'अ' मिलकर लम्बा 'आ' बनते हैं: रुद्र + अष्टक → रुद्राष्टक।"
            }
          },
          {
            "name": "anusvāra",
            "rule": "m + consonant → ṃ",
            "explanation": {
              "en": "Final m stays m before the vowel of idam (written joined), and the m of idam becomes anusvāra (ṃ) before the p of proktam: rudrāṣṭakam idam → rudrāṣṭakamidaṃ.",
              "hi": "इदम् के स्वर से पहले अन्तिम 'म्' वैसा ही रहता है (जुड़कर लिखा जाता है), और प्रोक्तम् के 'प' से पहले इदम् का 'म्' अनुस्वार (ं) बन जाता है: रुद्राष्टकम् इदम् → रुद्राष्टकमिदं।"
            }
          }
        ],
