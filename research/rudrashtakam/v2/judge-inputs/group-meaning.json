  "verse": {
    "id": "v2",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "निराकारमोङ्कारमूलं",
            "iast": "nirākāramoṅkāramūlaṃ"
          },
          {
            "id": "w2",
            "text": "तुरीयं",
            "iast": "turīyaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w3",
            "text": "गिराज्ञानगोतीतमीशं",
            "iast": "girājñānagotītamīśaṃ"
          },
          {
            "id": "w4",
            "text": "गिरीशम्",
            "iast": "girīśam"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w5",
            "text": "करालं",
            "iast": "karālaṃ"
          },
          {
            "id": "w6",
            "text": "महाकालकालं",
            "iast": "mahākālakālaṃ"
          },
          {
            "id": "w7",
            "text": "कृपालं",
            "iast": "kṛpālaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w8",
            "text": "गुणागारसंसारपारं",
            "iast": "guṇāgārasaṃsārapāraṃ"
          },
          {
            "id": "w9",
            "text": "नतोऽहम्",
            "iast": "nato'ham"
          }
        ],
        "end": "॥ २ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w1"
        ],
        "iast": "nir-ākāram",
        "type": "bahuvrīhi",
        "subtype": "prādi-bahuvrīhi",
        "vigraha": "निर्गतः आकारः यस्मात् सः, तम्",
        "meaning": {
          "en": "(Him) from whom all form has gone",
          "hi": "(उन्हें) जिनका कोई आकार नहीं"
        },
        "note": {
          "en": "nis 'without' + ākāra 'form, shape': one who has no form. The s of nis becomes r before the vowel. It describes the Lord (īśam) and takes his masculine accusative ending.",
          "hi": "निस् 'रहित' + आकार 'रूप': जिसका कोई रूप नहीं। स्वर से पहले निस् का स् र् बन जाता है। यह ईशम् का विशेषण है, इसलिए उसी की तरह पुंलिंग द्वितीया में है।"
        }
      },
      "c2": {
        "members": [
          "w1"
        ],
        "iast": "oṅkāra-mūlam",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī-tatpuruṣa",
        "vigraha": "ओङ्कारस्य मूलम्",
        "meaning": {
          "en": "the root of the syllable Om",
          "hi": "ओंकार का मूल"
        },
        "note": {
          "en": "oṅkāra 'the syllable Om' + mūla 'root, source': 'the root of Om'. A noun phrase, so it keeps the gender of mūla and stands beside īśam in the same case.",
          "hi": "ओङ्कार 'ॐ अक्षर' + मूल 'जड़, स्रोत': 'ओंकार का मूल'। यह संज्ञा है, इसलिए मूल का लिंग रखता है और ईशम् के साथ उसी विभक्ति में है।"
        }
      },
      "c3": {
        "members": [
          "w3"
        ],
        "iast": "girā-jñāna-go-atītam",
        "type": "tatpuruṣa",
        "subtype": "dvitīyā-tatpuruṣa",
        "structure": "((girā-jñāna-go)-atīta)",
        "vigraha": "गिरा च ज्ञानं च गावः च गिराज्ञानगावः, ताः अतीतः, तम्",
        "meaning": {
          "en": "(Him) who has gone beyond speech, knowledge and the senses",
          "hi": "(उन्हें) जो वाणी, ज्ञान और इन्द्रियों से परे हैं"
        },
        "note": {
          "en": "girā-jñāna-go is a dvandva, 'speech, knowledge and the senses'; atīta 'gone beyond' takes what is passed in the accusative, so the whole is a dvitīyā tatpuruṣa. go + atīta joins as gotīta (the a after o is dropped).",
          "hi": "गिरा-ज्ञान-गो द्वन्द्व है, 'वाणी, ज्ञान और इन्द्रियाँ'; अतीत 'पार गया हुआ' जिसे पार करता है उसे द्वितीया में लेता है, इसलिए पूरा समास द्वितीया तत्पुरुष है। गो + अतीत मिलकर गोतीत बनता है (ओ के बाद का अ लुप्त)।"
        }
      },
      "c4": {
        "members": [
          "w4"
        ],
        "iast": "giri-īśam",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī-tatpuruṣa",
        "vigraha": "गिरेः ईशः, तम्",
        "meaning": {
          "en": "the Lord of the mountain",
          "hi": "पर्वत के स्वामी"
        },
        "note": {
          "en": "giri 'mountain' + īśa 'lord'; i + ī merge into ī. A familiar name of Śiva, lord of Kailāsa.",
          "hi": "गिरि 'पर्वत' + ईश 'स्वामी'; इ + ई मिलकर ई। शिव का प्रसिद्ध नाम, कैलास के स्वामी।"
        }
      },
      "c5": {
        "members": [
          "w6"
        ],
        "iast": "mahā-kāla-kālam",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī-tatpuruṣa",
        "structure": "((mahā-kāla)-kāla)",
        "vigraha": "महान् कालः महाकालः, तस्य कालः, तम्",
        "meaning": {
          "en": "the Death even of Mahākāla, great Death",
          "hi": "महाकाल के भी काल"
        },
        "note": {
          "en": "mahā-kāla 'great Time' is a karmadhāraya (mahat becomes mahā at the start of a compound); with a second kāla it forms a ṣaṣṭhī tatpuruṣa, 'the kāla (ender) of Mahākāla'.",
          "hi": "महा-काल 'महान् काल' कर्मधारय है (समास के आरम्भ में महत् महा बन जाता है); दूसरे काल के साथ यह षष्ठी तत्पुरुष बनता है: 'महाकाल का काल (अन्त करने वाला)'।"
        }
      },
      "c6": {
        "members": [
          "w8"
        ],
        "iast": "guṇa-āgāra-saṃsāra-pāram",
        "type": "karmadhāraya",
        "subtype": "viśeṣaṇobhayapada",
        "structure": "((guṇa-āgāra)-(saṃsāra-pāra))",
        "vigraha": "गुणानाम् आगारः गुणागारः, संसारस्य पारः संसारपारः; गुणागारः च असौ संसारपारः च, तम्",
        "meaning": {
          "en": "(Him) who is the home of virtues and the far shore of worldly life",
          "hi": "(उन्हें) जो गुणों के धाम और संसार के पार हैं"
        },
        "note": {
          "en": "Two ṣaṣṭhī tatpuruṣas, guṇa-āgāra 'house of virtues' and saṃsāra-pāra 'far shore of saṃsāra', joined as two descriptions of one person. The whole can also be read as one chain, (guṇa-āgāra-saṃsāra)-pāra, 'the far shore of saṃsāra, which is a house of the guṇas'; see the alternative on w8.",
          "hi": "दो षष्ठी तत्पुरुष, गुण-आगार 'गुणों का घर' और संसार-पार 'संसार का उस पार का किनारा', एक ही व्यक्ति के दो विशेषणों की तरह जुड़े हैं। पूरे समास को एक शृंखला भी पढ़ा जा सकता है, (गुण-आगार-संसार)-पार, 'गुणों के घर रूपी संसार का पार'; w8 का विकल्प देखें।"
        }
      }
    },
