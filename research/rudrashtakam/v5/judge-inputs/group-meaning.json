  "verse": {
    "id": "v5",
    "lines": [
      {
        "words": [
          {
            "id": "w1",
            "text": "प्रचण्डं",
            "iast": "pracaṇḍaṃ"
          },
          {
            "id": "w2",
            "text": "प्रकृष्टं",
            "iast": "prakṛṣṭaṃ"
          },
          {
            "id": "w3",
            "text": "प्रगल्भं",
            "iast": "pragalbhaṃ"
          },
          {
            "id": "w4",
            "text": "परेशं",
            "iast": "pareśaṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w5",
            "text": "अखण्डं",
            "iast": "akhaṇḍaṃ"
          },
          {
            "id": "w6",
            "text": "अजं",
            "iast": "ajaṃ"
          },
          {
            "id": "w7",
            "text": "भानुकोटिप्रकाशम्",
            "iast": "bhānukoṭiprakāśam"
          }
        ],
        "end": "।"
      },
      {
        "words": [
          {
            "id": "w8",
            "text": "त्रयःशूलनिर्मूलनं",
            "iast": "trayaḥśūlanirmūlanaṃ"
          },
          {
            "id": "w9",
            "text": "शूलपाणिं",
            "iast": "śūlapāṇiṃ"
          }
        ],
        "end": ""
      },
      {
        "words": [
          {
            "id": "w10",
            "text": "भजेऽहं",
            "iast": "bhaje'haṃ"
          },
          {
            "id": "w11",
            "text": "भवानीपतिं",
            "iast": "bhavānīpatiṃ"
          },
          {
            "id": "w12",
            "text": "भावगम्यम्",
            "iast": "bhāvagamyam"
          }
        ],
        "end": "॥ ५ ॥"
      }
    ],
    "compounds": {
      "c1": {
        "members": [
          "w4"
        ],
        "iast": "para-īśam",
        "type": "karmadhāraya",
        "vigraha": "परः ईशः परेशः, तम्",
        "meaning": {
          "en": "the supreme Lord",
          "hi": "परम ईश्वर"
        },
        "note": {
          "en": "para 'highest, beyond' describes īśa 'lord': the Lord who is above all.",
          "hi": "'पर' (सबसे ऊँचा, परे) 'ईश' (स्वामी) का विशेषण है: वह स्वामी जो सबसे ऊपर है।"
        }
      },
      "c2": {
        "members": [
          "w5"
        ],
        "iast": "a-khaṇḍam",
        "type": "nañ-tatpuruṣa",
        "vigraha": "न खण्डः अखण्डः, तम्",
        "meaning": {
          "en": "whole, not in pieces",
          "hi": "अखण्ड, जिसके टुकड़े नहीं"
        },
        "note": {
          "en": "a- 'not' with khaṇḍa 'broken, a piece': whole, undivided.",
          "hi": "'अ' (नहीं) और 'खण्ड' (टूटा हुआ, टुकड़ा): पूरा, अविभाजित।"
        }
      },
      "c3": {
        "members": [
          "w6"
        ],
        "iast": "a-jam",
        "type": "nañ-tatpuruṣa",
        "vigraha": "न जः अजः, तम्",
        "meaning": {
          "en": "unborn",
          "hi": "अजन्मा"
        },
        "note": {
          "en": "a- 'not' with ja 'born' (from √jan): one who was never born.",
          "hi": "'अ' (नहीं) और 'ज' (जन्मा, √जन् से): जिसका कभी जन्म नहीं हुआ।"
        }
      },
      "c4": {
        "members": [
          "w7"
        ],
        "iast": "bhānu-koṭi-prakāśam",
        "type": "bahuvrīhi",
        "structure": "((bhānu-koṭi)-prakāśa)",
        "vigraha": "भानूनां कोटिः भानुकोटिः, भानुकोटेः इव प्रकाशः यस्य सः, तम्",
        "meaning": {
          "en": "(Him) whose light is like that of ten million suns",
          "hi": "(उन्हें) जिनका प्रकाश करोड़ों सूर्यों जैसा है"
        },
        "note": {
          "en": "bhānu-koṭi 'ten million suns' (ṣaṣṭhī tatpuruṣa) is joined to prakāśa 'light'; the whole describes Śiva, who has such light, so it takes His case.",
          "hi": "भानु-कोटि 'करोड़ों सूर्य' (षष्ठी तत्पुरुष) 'प्रकाश' से जुड़ता है; पूरा समास उन शिव का वर्णन करता है जिनका ऐसा प्रकाश है, इसलिए उन्हीं की विभक्ति लेता है।"
        }
      },
      "c5": {
        "members": [
          "w8"
        ],
        "iast": "trayaḥ-śūla-nirmūlanam",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "structure": "((trayaḥ-śūla)-nirmūlana)",
        "vigraha": "त्रयः शूलाः त्रयःशूलाः, तेषां निर्मूलनः, तम्",
        "meaning": {
          "en": "the uprooter of the three kinds of pain",
          "hi": "तीनों प्रकार के कष्टों को जड़ से मिटाने वाले"
        },
        "note": {
          "en": "Regular Sanskrit would put the stem tri- first (tri-śūla); the text keeps trayaḥ, the nominative plural, inside the compound, an ārṣa (licensed irregular) usage. nirmūlana is the agent noun 'uprooter'.",
          "hi": "नियमित संस्कृत में समास के आरम्भ में 'त्रि' (त्रिशूल) आता; पाठ समास के भीतर 'त्रयः' (प्रथमा बहुवचन) रखता है, जो आर्ष प्रयोग है। 'निर्मूलन' कर्ता-वाचक संज्ञा है: 'जड़ से उखाड़ने वाला'।"
        }
      },
      "c6": {
        "members": [
          "w9"
        ],
        "iast": "śūla-pāṇim",
        "type": "bahuvrīhi",
        "vigraha": "शूलं पाणौ यस्य सः, तम्",
        "meaning": {
          "en": "(Him) who has the trident in His hand",
          "hi": "(उन्हें) जिनके हाथ में त्रिशूल है"
        },
        "note": {
          "en": "Bahuvrīhi: 'he in whose hand is the spear', a well-known name of Śiva.",
          "hi": "बहुव्रीहि: 'जिसके हाथ में शूल है', शिव का प्रसिद्ध नाम।"
        }
      },
      "c7": {
        "members": [
          "w11"
        ],
        "iast": "bhavānī-patim",
        "type": "tatpuruṣa",
        "subtype": "ṣaṣṭhī",
        "vigraha": "भवान्याः पतिः भवानीपतिः, तम्",
        "meaning": {
          "en": "the husband of Bhavānī",
          "hi": "भवानी के पति"
        },
        "note": {
          "en": "bhavānyāḥ patiḥ, 'the husband of Bhavānī'.",
          "hi": "भवान्याः पतिः, 'भवानी के पति'।"
        }
      },
      "c8": {
        "members": [
          "w12"
        ],
        "iast": "bhāva-gamyam",
        "type": "tatpuruṣa",
        "subtype": "tṛtīyā",
        "vigraha": "भावेन गम्यः भावगम्यः, तम्",
        "meaning": {
          "en": "reached through love",
          "hi": "भाव (प्रेम) से पाए जाने वाले"
        },
        "note": {
          "en": "bhāvena gamyaḥ, 'to be reached by bhāva', feeling or love.",
          "hi": "भावेन गम्यः, 'भाव (प्रेम) के द्वारा पाने योग्य'।"
        }
      }
    },
