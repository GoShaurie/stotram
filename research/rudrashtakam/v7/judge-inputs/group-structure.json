        ],
        "sandhi": [
          {
            "name": "jaśtva",
            "rule": "t + u → d + u",
            "explanation": {
              "en": "Final t becomes the voiced d before the vowel u of umā (next display word): yāvat + umā → yāvad umā.",
              "hi": "अन्तिम 'त्' आगे के स्वर 'उ' (उमा) के कारण घोष 'द्' बन जाता है: यावत् + उमा → यावद् उमा।"
            }
          }
        ],
        "components": [
