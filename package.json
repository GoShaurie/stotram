{
  "name": "stotram",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "validate:publish": "node scripts/validate.mjs --publish",
    "schema": "node scripts/export-schema.mjs",
    "checks": ".venv/bin/python -m checks"
  },
  "engines": {
    "node": ">=18"
  },
  "version": "0.1.0",
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
